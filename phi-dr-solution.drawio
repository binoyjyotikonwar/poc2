<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="pattern" name="1 · Universal DR Pattern">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="Universal DR Pattern — applies IDENTICALLY to every PHI system (IL, PAS, FileNet, CRM, Samvaad, CHUB, PIXEL, PruServices, Buy-Online, D2C, Corp, Health App, Fyntune)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1120" height="40" as="geometry"/>
        </mxCell>

        <!-- caller -->
        <mxCell id="caller" value="Any caller&#10;(Apigee channel, another dual-AZ system,&#10;or a DIRECT-az1 caller: Health App / Fyntune)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="320" height="60" as="geometry"/>
        </mxCell>

        <!-- stable endpoint -->
        <mxCell id="stable" value="① STABLE AZ-AGNOSTIC ENDPOINT&#10;&lt;service&gt;.lb1-pruinhlth-prd-&lt;proj&gt;.pru.intranet.asia  (no az1/az2)&#10;Regional Internal L4 passthrough NLB · failover backend · health-checked readiness path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="180" width="520" height="80" as="geometry"/>
        </mxCell>

        <!-- az1 / az2 -->
        <mxCell id="az1" value="AZ1 — ACTIVE&#10;nginx-ingress&#10;pods running" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="240" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="az2" value="AZ2 — WARM STANDBY&#10;② min=1 (HTTP)&#10;Pub/Sub consumer GATED OFF&#10;until failover (active-passive)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="660" y="320" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- shared data -->
        <mxCell id="data" value="SHARED STATEFUL LAYER — automatic zone-failover (RPO ≈ 0):  Cloud SQL REGIONAL · Redis STANDARD_HA · Pub/Sub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="540" width="600" height="60" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="p_e1" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="caller" target="stable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e2" value="active" style="endArrow=block;html=1;strokeColor=#3366cc;strokeWidth=2;fontColor=#3366cc;" edge="1" parent="1" source="stable" target="az1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e3" value="failover &lt;30s" style="endArrow=block;html=1;dashed=1;strokeColor=#cc0000;strokeWidth=2;fontColor=#cc0000;" edge="1" parent="1" source="stable" target="az2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e4" style="endArrow=block;html=1;strokeColor=#82b366;" edge="1" parent="1" source="az1" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e5" style="endArrow=block;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="az2" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- fix steps panel -->
        <mxCell id="steps" value="THE 5-STEP TEMPLATE (apply to every system)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="640" width="600" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="① Stable AZ-agnostic endpoint over az1+az2 ingress (L4 NLB failover)" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="315" y="668" width="580" height="20" as="geometry"/></mxCell>
        <mxCell id="s2" value="② Warm az2 (HTTP min=1); Pub/Sub consumers active-passive (gate off, scale on failover)" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="315" y="694" width="580" height="20" as="geometry"/></mxCell>
        <mxCell id="s3" value="③ Rewrite every -az1- in config → stable name (cross-system) or K8s service name (same cluster)" style="text;html=1;align=left;fontColor=#c62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315" y="720" width="580" height="20" as="geometry"/></mxCell>
        <mxCell id="s4" value="④ Repoint Apigee target servers → stable name" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="315" y="746" width="580" height="20" as="geometry"/></mxCell>
        <mxCell id="s5" value="⑤ Fix az2 secrets/bugs; add missing az2 plumbing (e.g. Samvaad az2 VPC connector)" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="315" y="772" width="580" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="mesh" name="2 · Platform Solution Mesh">
