  <diagram id="info" name="3 · Reference Info (self-contained)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="it" value="Reference Info — everything you need without opening a doc" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1200" height="26" as="geometry"/></mxCell>

        <mxCell id="p_auto" value="WHAT AUTO-SURVIVES A ZONE (az1) LOSS — no action&#10;• Cloud SQL platform-domain-prod — REGIONAL HA — 2–5 min, RPO≈0&#10;• Memorystore Redis — STANDARD_HA — &lt;1 min&#10;• Pub/Sub (90+ topics) — global, zone-agnostic — instant&#10;• Apigee engine — single-region, zone-agnostic&#10;• IAM Workload Identity (DR ns) + az2 firewall — pre-provisioned&#10;⇒ DR is 'just' two things: bring up az2 COMPUTE + shift ROUTING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="560" height="200" as="geometry"/></mxCell>

        <mxCell id="p_rto" value="RTO / RPO&#10;• Zone (az1) loss — stable endpoint + warm az2:  RTO &lt; 30s · RPO ≈ 0 · automatic&#10;• Zone loss — pilot-light (az2 at 0 + control loop):  RTO 3–5 min · RPO ≈ 0&#10;• Full REGION (asia-south1) loss:  NOT covered → Phase 2 (uncomment Cloud SQL cross-region replica to asia-south2)&#10;• PAS/BaNCS owns its own cross-region DR: RTO 1h / RPO 2h (region loss only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="60" width="560" height="200" as="geometry"/></mxCell>

        <mxCell id="p_bugs" value="FIX BEFORE WARMING az2&#10;• Bug#1 (HIGH): PPMC application-dr.yml → UAT (pruinhlth-nprd-uat-f8hev4-3c6b, topicPrefix: dr). Fix: DELETE dr profile, run az2 on prod. Else warm az2 writes prod Pub/Sub to UAT.&#10;• Bug#2 (MED): claim-processing DR yaml has ORGANIZATION_CERT_BASE64 commented out. Fix: uncomment (secretKeyRef sahi-certificates/ssl-cert) — else mTLS to TPA fails in DR." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="60" width="480" height="200" as="geometry"/></mxCell>

        <mxCell id="p_rewrite" value="CONFIG REWRITES — kill every -az1- (FIX ③ · THE RULE)&#10;IL:   domainSuffix · filenet.baseUrl · pas.api.baseUrl   → …lb1-pruinhlth-prd-chbb3e…&#10;PAS:  bancsHost (…-az1-vpkcai) · domainSuffix   → …-vpkcai / …-chbb3e&#10;CRM:  crm.simple.baseUrl (…-az1-rzg0c4)   → …-rzg0c4&#10;FileNet: cp4ba/filenet host   → …-nhq8h1&#10;Samvaad: egress hosts → stable  +  ADD vpc-connector-prd-az2&#10;Health App: own ingress + comms-svc + party-management → stable&#10;Fyntune: IL link + own -az1- deps → stable&#10;Apigee: repoint all 17 target servers → stable (FIX ④)&#10;KEEP as-is (already AZ-safe): http://payment-service, http://domain-graph, http://tpa-partner (K8s service names)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="800" height="260" as="geometry"/></mxCell>

        <mxCell id="p_pubsub" value="PUB/SUB — why warm az2 needs care (FIX ②)&#10;Warm az2 pods use the same project + topicPrefix: prod → they would attach to the SAME subscriptions as az1 = competing consumers.&#10;DECISION: ACTIVE-PASSIVE — gate the Pub/Sub consumer OFF on warm az2 (HTTP still served); on failover, enable it / scale up. Pure consumers (CRM/CHUB) stay at 0 and scale on failover (Pub/Sub retains messages → no loss).&#10;message_ordering=true · max_delivery_attempts=5 · each topic has a -dl-topic DLQ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="290" width="820" height="180" as="geometry"/></mxCell>

        <mxCell id="p_issues" value="THE 10 ISSUES (map badges) → FIX&#10;① direct-az1 callers bypassing Apigee (Health App, Fyntune) → stable name&#10;② PAS az1-pinned + own region DR (RTO 1h) → dual-AZ pattern; 1h = region loss only&#10;③ Samvaad egress vpc-connector-prd-az1 → add az2 connector + stable&#10;④ IL→peers -az1- config (domainSuffix, filenet, pas.api, bancsHost, crm.simple) → THE RULE (#1)&#10;⑤ warming az2 = competing Pub/Sub consumer → active-passive&#10;⑥ FileNet DB2-VM + on-prem AD SPOF → own HA/DR&#10;⑦ Apigee targets all -az1- → repoint to stable&#10;⑧ Bug#1 dr→UAT · Bug#2 missing mTLS cert → fix before warming&#10;⑨ zone-vs-region: az2 = Mumbai zone; asia-south2 = Delhi region&#10;⑩ coordinate rollout across ALL systems or the east-west mesh breaks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="800" height="300" as="geometry"/></mxCell>

        <mxCell id="p_survive" value="TRAFFIC TYPES → COVERAGE&#10;• via Apigee (D2C, Corp, Buy-Online, PruServices, WhatsApp, Medibuddy): zone-safe → repoint targets&#10;• direct -az1- HTTP (Health App, Fyntune): stable endpoint&#10;• east-west -az1- config (IL↔PAS/FileNet/CRM): THE RULE&#10;• Pub/Sub (CHUB; CRM/PPMC infra): active-passive&#10;• K8s service names (payment-service, domain-graph, tpa-partner): already safe&#10;&#10;GKE: az1 = gke-...-chbb3e-az1 (ns platform-domain-prod) · az2 = gke-...-chbb3e-az2 (ns platform-domain-prd-dr)&#10;Health check: HTTPS 443 /actuator/health/readiness · 5s · 2 fails = unhealthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="490" width="820" height="390" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="eastwest" name="4 · East-West Fix (before → after)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="et" value="East-West Fix (issue ④, the #1 platform-wide fix) — how a service-to-service call is rewritten so it survives an az1 loss" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1640" height="26" as="geometry"/></mxCell>

        <mxCell id="rule" value="THE RULE:  no dependency HOSTNAME may contain az1/az2.   Same GKE cluster → K8s service name (http://&lt;svc&gt;).   Cross-cluster / cross-project → the target system's STABLE NLB endpoint (…lb1-pruinhlth-prd-&lt;proj&gt;… , no az1)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;spacingLeft=10;fontStyle=1;fontColor=#1a73e8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="44" as="geometry"/></mxCell>

        <!-- ================= BEFORE ================= -->
        <mxCell id="before" value="BEFORE — hardcoded -az1- (breaks on az1 loss)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#c5221f;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="800" height="380" as="geometry"/></mxCell>
        <mxCell id="bf_caller" value="IL caller pod&#10;(az1)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.pod;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="46" height="46" as="geometry"/></mxCell>
        <mxCell id="bf_ing" value="PAS az1 ingress" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.ing;" vertex="1" parent="1"><mxGeometry x="430" y="200" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="bf_pod" value="PAS az1 pod" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.pod;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="46" height="46" as="geometry"/></mxCell>
        <mxCell id="bf_cfg" value="application-prod.yml (today)&#10;domainSuffix : lb1-pruinhlth-prd-az1-chbb3e.pru.intranet.asia&#10;pas.api.baseUrl : https://pas-services-prod.lb1-pruinhlth-prd-az1-chbb3e…&#10;filenet.baseUrl : https://document-services-prod.lb1-pruinhlth-prd-az1-chbb3e…&#10;bancsHost : core-prod.lb1-pruinhlth-prd-az1-vpkcai…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="700" height="170" as="geometry"/></mxCell>
        <mxCell id="bf_e1" value="hardcoded …-az1-… host" style="endArrow=block;html=1;strokeColor=#c5221f;strokeWidth=2;fontColor=#c5221f;" edge="1" parent="1" source="bf_caller" target="bf_ing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bf_e2" style="endArrow=block;html=1;strokeColor=#c5221f;strokeWidth=2;" edge="1" parent="1" source="bf_ing" target="bf_pod"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bf_x" value="✖ az1 down → host dead → call FAILS (warm az2 exists but nobody points at it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5221f;strokeColor=#7f0000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="255" width="470" height="34" as="geometry"/></mxCell>

        <!-- ================= AFTER ================= -->
        <mxCell id="after" value="AFTER — AZ-agnostic (survives az1 loss)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#188038;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="810" height="380" as="geometry"/></mxCell>

        <!-- Lane A -->
        <mxCell id="laneA" value="Lane A — SAME cluster: K8s service name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#7cb342;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#558b2f;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="165" width="760" height="90" as="geometry"/></mxCell>
        <mxCell id="a_caller" value="caller pod" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.pod;" vertex="1" parent="1"><mxGeometry x="905" y="190" width="38" height="38" as="geometry"/></mxCell>
