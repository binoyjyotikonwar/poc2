        <mxCell id="pe2" value="IL APIs" style="endArrow=block;html=1;strokeColor=#34a853;strokeWidth=2;" edge="1" parent="1" source="p_apigee" target="u_il"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" value="IL stable name" style="endArrow=block;html=1;strokeColor=#00897b;strokeWidth=2;" edge="1" parent="1" source="u_health" target="u_il"><mxGeometry relative="1" as="geometry"/></mxCell>
