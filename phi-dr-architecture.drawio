<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="ref" name="1 · DR Reference Architecture (detailed)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="DR Reference Architecture — one system (Integration Layer shown). The SAME stack repeats for every PHI system. Read left→right: front door → stable endpoint → dual-AZ GKE → shared data." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="26" as="geometry"/></mxCell>

        <mxCell id="region" value="GCP region  asia-south1   ·   az1 = Mumbai zone-A (ACTIVE)   ·   az2 = Mumbai zone-B (WARM)   —   az2 is a ZONE, not asia-south2/Delhi (that is region DR = Phase 2)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f2f7fd;strokeColor=#4285F4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#1a73e8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1660" height="960" as="geometry"/></mxCell>

        <!-- FRONT DOOR -->
        <mxCell id="b_inet" value="Internet / 3rd-party partners&#10;Medibuddy · Mediassist · Razorpay (mTLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="210" height="50" as="geometry"/></mxCell>
        <mxCell id="b_waf" value="Imperva WAF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="112" width="90" height="46" as="geometry"/></mxCell>
        <mxCell id="i_armor" value="Cloud Armor" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.cloud_armor;" vertex="1" parent="1"><mxGeometry x="420" y="108" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="i_xlb" value="Apigee XLB (external)&#10;api.pruinhlthprod.apigee.prudentialhealth.in" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.apigee_api_platform;" vertex="1" parent="1"><mxGeometry x="540" y="108" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b_intra" value="Intranet callers / other PHI systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaed;strokeColor=#5f6368;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="185" width="210" height="46" as="geometry"/></mxCell>
        <mxCell id="i_ilb" value="Apigee ILB (internal)&#10;api.pruinhlthprod.apigee.pru.intranet.asia" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.apigee_api_platform;" vertex="1" parent="1"><mxGeometry x="540" y="185" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="b_direct" value="DIRECT callers (bypass Apigee): Health App · Fyntune&#10;FIX ③: must call the IL STABLE name (or az1-failover-DNS shortcut = no change)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="258" width="440" height="54" as="geometry"/></mxCell>

        <!-- STABLE ENDPOINT -->
        <mxCell id="i_dns" value="Cloud DNS (private)&#10;*.lb1-pruinhlth-prd-chbb3e.pru.intranet.asia  ← STABLE (no az1/az2)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.cloud_dns;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="i_nlb" value="Internal L4 passthrough NLB (regional)&#10;VIP :443 · failover backend (az1 primary / az2 failover) · TLS passes through (mTLS intact)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.cloud_load_balancing;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="50" height="50" as="geometry"/></mxCell>

        <!-- AZ1 -->
        <mxCell id="az1" value="GKE — AZ1 (ACTIVE)   gke-pruinhlth-prod-prd-chbb3e-az1   ·   namespace platform-domain-prod" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#3b5b8c;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="600" height="300" as="geometry"/></mxCell>
        <mxCell id="i_gke1" value="GKE cluster az1&#10;(regional, 3 zones)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.container_engine;" vertex="1" parent="1"><mxGeometry x="450" y="475" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="i_ing1" value="nginx-ingress&#10;(NEG → NLB)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.ing;" vertex="1" parent="1"><mxGeometry x="640" y="477" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="i_sec1" value="sahi-certificates&#10;(mTLS ssl-cert)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.secret;" vertex="1" parent="1"><mxGeometry x="820" y="477" width="40" height="40" as="geometry"/></mxCell>
