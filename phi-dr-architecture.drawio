        <mxCell id="i_pod1b" value="IL pod" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.pod;" vertex="1" parent="1"><mxGeometry x="570" y="620" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="i_hpa1" value="HPA 1–N&#10;(CPU/Mem 70%)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.hpa;" vertex="1" parent="1"><mxGeometry x="700" y="620" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="i_svc1" value="K8s service&#10;http://payment-service (east-west, AZ-safe)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.svc;" vertex="1" parent="1"><mxGeometry x="850" y="620" width="40" height="40" as="geometry"/></mxCell>

        <!-- AZ2 -->
        <mxCell id="az2" value="GKE — AZ2 (WARM standby)   gke-...-chbb3e-az2   ·   namespace platform-domain-prd-dr" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#a6750a;" vertex="1" parent="1"><mxGeometry x="1050" y="430" width="600" height="300" as="geometry"/></mxCell>
        <mxCell id="i_gke2" value="GKE cluster az2&#10;(infra ready)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.container_engine;" vertex="1" parent="1"><mxGeometry x="1080" y="475" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="i_ing2" value="nginx-ingress&#10;(NEG → NLB)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.ing;" vertex="1" parent="1"><mxGeometry x="1270" y="477" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="i_pod2" value="IL pod&#10;WARM min=1 (FIX ②)" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#326CE5;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.kubernetes.pod;" vertex="1" parent="1"><mxGeometry x="1080" y="620" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="b_ps2" value="Pub/Sub consumer GATED OFF until failover (active-passive) · runs SAME prod config&#10;FIX ⑧: Bug#1 (application-dr.yml → UAT) must be fixed first, else it writes to UAT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="600" width="420" height="80" as="geometry"/></mxCell>

        <!-- DATA -->
        <mxCell id="data" value="Shared stateful layer — AUTOMATIC zone-failover, no action needed (this is why DR is 'just' compute + routing)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#188038;" vertex="1" parent="1"><mxGeometry x="420" y="770" width="1230" height="180" as="geometry"/></mxCell>
        <mxCell id="i_sql" value="Cloud SQL platform-domain-prod&#10;REGIONAL HA · 13 DBs · RTO 2–5min · RPO≈0" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.cloud_sql;" vertex="1" parent="1"><mxGeometry x="520" y="815" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="i_redis" value="Memorystore Redis 10.141.179.4:6378&#10;STANDARD_HA · &lt;1min" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.cloud_memorystore;" vertex="1" parent="1"><mxGeometry x="850" y="815" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="i_ps" value="Pub/Sub · 90+ topics&#10;global, zone-agnostic · instant" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.cloud_pubsub;" vertex="1" parent="1"><mxGeometry x="1200" y="815" width="48" height="48" as="geometry"/></mxCell>

        <!-- FLOW EDGES with numbered badges -->
        <mxCell id="e_wf1" style="endArrow=block;html=1;strokeColor=#c5221f;" edge="1" parent="1" source="b_inet" target="b_waf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_wf2" style="endArrow=block;html=1;strokeColor=#c5221f;" edge="1" parent="1" source="b_waf" target="i_armor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_wf3" style="endArrow=block;html=1;strokeColor=#c5221f;" edge="1" parent="1" source="i_armor" target="i_xlb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_wf4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="b_intra" target="i_ilb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_x2d" value="repoint targets → stable" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="i_xlb" target="i_dns"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_i2d" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="i_ilb" target="i_dns"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_dir2d" style="endArrow=block;html=1;strokeColor=#00897b;strokeWidth=2;" edge="1" parent="1" source="b_direct" target="i_dns"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_d2n" value="resolve → VIP :443" style="endArrow=block;html=1;strokeColor=#5f6368;strokeWidth=2;" edge="1" parent="1" source="i_dns" target="i_nlb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_n21" value="ACTIVE" style="endArrow=block;html=1;strokeColor=#1a73e8;strokeWidth=3;fontColor=#1a73e8;" edge="1" parent="1" source="i_nlb" target="i_ing1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_n22" value="FAILOVER &lt;30s (2 HC fails)" style="endArrow=block;html=1;dashed=1;strokeColor=#c62828;strokeWidth=3;fontColor=#c62828;" edge="1" parent="1" source="i_nlb" target="i_ing2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_hc1" value="health check /actuator/health/readiness · 5s · 2 fails=unhealthy" style="endArrow=oval;startArrow=oval;html=1;dashed=1;strokeColor=#9334e6;fontColor=#9334e6;fontSize=10;" edge="1" parent="1" source="i_nlb" target="i_ing1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="497"/></Array></mxGeometry></mxCell>
        <mxCell id="e_ing1pod" style="endArrow=block;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="i_ing1" target="i_pod1a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ing1pod2" style="endArrow=block;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="i_ing1" target="i_pod1b"><mxGeometry relative="1" as="geometry"/></mxCell>
