        <mxCell id="n4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c62828;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="n5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#34a853;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="700" width="26" height="26" as="geometry"/></mxCell>

        <!-- failover callout -->
        <mxCell id="c_fail" value="FAILOVER SEQUENCE:  ① Cloud SQL/Redis auto zone-failover (RPO≈0)  →  ② NLB health-check marks az1 unhealthy (~10s)  →  ③ NLB steers ALL traffic to az2 WARM pods (no restart, URL unchanged)  →  ④ HPA scales az2 to real load  →  RTO &lt; 30s." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="600" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="platarch" name="2 · Platform Connectivity (detailed)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="pt" value="Platform DR Architecture — every system = az1+az2 GKE behind a stable-name Internal-NLB. Arrows = inter-system calls (all via stable names after fix). Number = which of the 5 steps apply." style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1680" height="26" as="geometry"/></mxCell>

        <!-- side panels -->
        <mxCell id="pnl_steps" value="5-STEP TEMPLATE (per system)&#10;① Stable AZ-agnostic endpoint (Internal L4 NLB, failover backend) over az1+az2 ingress&#10;② Warm az2 (HTTP min=1); Pub/Sub consumers active-passive (gate off; scale on failover)&#10;③ Rewrite every -az1- in config → stable name / K8s service name&#10;④ Repoint Apigee target servers → stable name&#10;⑤ Fix az2 secrets/bugs; add missing az2 plumbing (Samvaad az2 VPC connector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="pnl_leg" value="LEGEND&#10;green = via Apigee (DR-safe)   ·   teal = stable direct name   ·   blue = Pub/Sub   ·   orange = VPC connector&#10;Each unit: ⛭ Internal-NLB (stable EP) + GKE az1 (active) + GKE az2 (warm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="720" width="560" height="80" as="geometry"/></mxCell>
        <mxCell id="pnl_roll" value="ROLLOUT ORDER (Issue ⑩ — one coordinated program, or the east-west mesh breaks)&#10;1. IL (hub)  →  2. direct-az1 callers (Health App, Fyntune)  →  3. downstream (PAS, FileNet, CRM, Samvaad+az2 connector, PIXEL, CHUB)  →  4. Apigee channels (repoint only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="810" width="560" height="60" as="geometry"/></mxCell>

        <!-- Apigee + channels -->
        <mxCell id="p_apigee" value="Apigee Gateway&#10;XLB (external) + ILB (internal), zone-agnostic" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.apigee_api_platform;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="50" height="44" as="geometry"/></mxCell>
        <mxCell id="p_chan" value="Channels (via Apigee, already zone-safe): D2C(47) · Corp(144) · Buy-Online(131 'IL APIs via Apigee') · PruServices(125) · WhatsApp&#10;FIX ④: repoint Apigee targets → stable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="500" height="70" as="geometry"/></mxCell>

        <!-- IL hub -->
        <mxCell id="u_il" value="INTEGRATION LAYER · chbb3e (HUB)&#10;stable: *.lb1-pruinhlth-prd-chbb3e...&#10;FIX ③: domainSuffix, filenet.baseUrl, pas.api.baseUrl · ④ 17 Apigee targets · ⑤ Bug#1/#2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#a6750a;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="il_nlb" value="stable EP" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.cloud_load_balancing;" vertex="1" parent="1"><mxGeometry x="630" y="420" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="il_g1" value="az1 active" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.container_engine;" vertex="1" parent="1"><mxGeometry x="740" y="420" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="il_g2" value="az2 warm" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.container_engine;" vertex="1" parent="1"><mxGeometry x="860" y="420" width="38" height="38" as="geometry"/></mxCell>

        <!-- direct callers -->
        <mxCell id="u_health" value="Health App · rzg0c4 (az1+az2)&#10;was DIRECT -az1- (own ingress + comms-svc + party-management)&#10;FIX ①③: → stable names" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#00695c;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="h_g1" value="az1" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.container_engine;" vertex="1" parent="1"><mxGeometry x="250" y="285" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="h_g2" value="az2" style="sketch=0;html=1;pointerEvents=0;shadow=0;dashed=0;strokeColor=none;fillColor=#4285F4;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;shape=mxgraph.gcp2.container_engine;" vertex="1" parent="1"><mxGeometry x="300" y="285" width="34" height="34" as="geometry"/></mxCell>

