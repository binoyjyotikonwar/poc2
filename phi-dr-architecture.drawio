        <mxCell id="e_pod2redis" style="endArrow=block;html=1;strokeColor=#34a853;" edge="1" parent="1" source="i_pod1b" target="i_redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_hpa2ps" style="endArrow=block;html=1;strokeColor=#34a853;" edge="1" parent="1" source="i_hpa1" target="i_ps"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pod2b2sql" style="endArrow=block;html=1;dashed=1;strokeColor=#34a853;" edge="1" parent="1" source="i_pod2" target="i_sql"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- badges -->
        <mxCell id="n1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="150" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="n2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#202124;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="772" y="240" width="26" height="26" as="geometry"/></mxCell>
