        <mxCell id="pe5" value="stable" style="endArrow=block;html=1;strokeColor=#00897b;strokeWidth=2;" edge="1" parent="1" source="u_il" target="u_pas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe6" value="stable" style="endArrow=block;html=1;strokeColor=#00897b;strokeWidth=2;" edge="1" parent="1" source="u_il" target="u_fn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe7" value="Apigee/stable" style="endArrow=block;html=1;strokeColor=#34a853;strokeWidth=2;" edge="1" parent="1" source="u_il" target="u_crm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe8" value="stable" style="endArrow=block;html=1;strokeColor=#f9a825;strokeWidth=2;" edge="1" parent="1" source="u_il" target="u_pixel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe9" value="Pub/Sub" style="endArrow=block;html=1;strokeColor=#1565c0;strokeWidth=2;" edge="1" parent="1" source="u_il" target="u_chub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe10" value="vpc az1+az2" style="endArrow=block;html=1;strokeColor=#e65100;strokeWidth=2;" edge="1" parent="1" source="u_il" target="u_samv"><mxGeometry relative="1" as="geometry"/></mxCell>
