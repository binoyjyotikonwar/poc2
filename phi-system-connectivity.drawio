        <!-- ISSUES & FIXES panel (on the connectivity page) -->
        <mxCell id="ifpanel" value="ISSUES &amp; FIXES  —  badges ①–⑦ mark the spot on the map above · ⑧–⑨ are platform-wide" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfbf0;strokeColor=#999999;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1500" height="238" as="geometry"/>
        </mxCell>
        <mxCell id="if1" value="① Direct -az1- callers that BYPASS Apigee — Health App + Fyntune → Fix: point them at IL's STABLE name (or az1-failover-DNS shortcut, no code change)" style="text;html=1;align=left;fontColor=#c62828;" vertex="1" parent="1"><mxGeometry x="55" y="892" width="1470" height="20" as="geometry"/></mxCell>
        <mxCell id="if2" value="② PAS/BaNCS was az1-pinned + owns cross-region DR (RTO 1h) → Fix: dual-AZ via the pattern; the 1h RTO applies only to a FULL-REGION loss" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="914" width="1470" height="20" as="geometry"/></mxCell>
        <mxCell id="if3" value="③ Samvaad egress via vpc-connector-prd-az1 (no az2) → Fix: add an az2 VPC connector; route backend calls via the stable endpoint" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="936" width="1470" height="20" as="geometry"/></mxCell>
        <mxCell id="if4" value="④ IL → peers via -az1- CONFIG hostnames: domainSuffix · filenet.baseUrl · pas.api.baseUrl · bancsHost · crm.simple.baseUrl → Fix: rewrite to stable / K8s service name  (THE RULE — #1 platform-wide)" style="text;html=1;align=left;fontColor=#c62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="958" width="1470" height="20" as="geometry"/></mxCell>
        <mxCell id="if5" value="⑤ Warming az2 = competing Pub/Sub consumer (CHUB; CRM/PPMC in infra) → Fix: active-passive — gate the consumer OFF on warm az2; scale up on failover" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="980" width="1470" height="20" as="geometry"/></mxCell>
        <mxCell id="if6" value="⑥ FileNet depends on DB2-on-a-VM + on-prem AD (DSG001/002) — not GKE → Fix: its own HA/DR (out of GKE-AZ scope); document as a dependency" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="1002" width="1470" height="20" as="geometry"/></mxCell>
        <mxCell id="if7" value="⑦ All 17 Apigee target servers point at -az1- hosts (no failover) → Fix: repoint every target to the stable AZ-agnostic name (one-time)" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="1024" width="1470" height="20" as="geometry"/></mxCell>
        <mxCell id="if8" value="⑧ Bug#1 PPMC application-dr.yml → UAT project · Bug#2 claim-processing DR missing mTLS cert → Fix: drop dr profile (run prod) + uncomment ORGANIZATION_CERT_BASE64 — BEFORE warming az2" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="1046" width="1470" height="20" as="geometry"/></mxCell>
        <mxCell id="if9" value="⑨ Zone-vs-region confusion in the docs → Fix: az2 = a ZONE inside asia-south1 (Mumbai); asia-south2 = the Delhi REGION. This solution is ZONE DR; region DR is a separate phase." style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="55" y="1068" width="1470" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

