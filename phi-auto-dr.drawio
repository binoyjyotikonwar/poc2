<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="arch" name="Auto-DR Target Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="PHI Auto-DR — Target Architecture (stable AZ-agnostic endpoint + warm AZ2) · full system map &amp; issues: phi-system-connectivity.drawio" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="760" height="30" as="geometry"/>
        </mxCell>

        <!-- Zones (drawn first, behind) -->
        <mxCell id="az1zone" value="AZ1 — PRIMARY (active)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="360" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="az2zone" value="AZ2 — WARM STANDBY (min replica = 1)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="440" y="380" width="360" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="statezone" value="Shared stateful layer — automatic zone-failover (RPO ~ 0), no action needed" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="760" height="150" as="geometry"/>
        </mxCell>

        <!-- Callers -->
        <mxCell id="apigee" value="Apigee&lt;br&gt;(XLB external / ILB internal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="direct" value="Other internal components&lt;br&gt;(call the service URL DIRECTLY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="305" y="90" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="partners" value="External partners&lt;br&gt;(Medibuddy, Mediassist, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="570" y="90" width="230" height="70" as="geometry"/>
        </mxCell>

        <!-- Stable endpoint (key element) -->
        <mxCell id="stable" value="STABLE AZ-AGNOSTIC ENDPOINT&lt;br&gt;service.lb1-pruinhlth-prd-chbb3e.pru.intranet.asia&lt;br&gt;&lt;i&gt;Health-checked failover — Internal LB (L4/443) or Cloud DNS&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="210" y="240" width="420" height="90" as="geometry"/>
        </mxCell>

        <!-- AZ1 inside -->
        <mxCell id="az1ing" value="nginx-ingress (AZ1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="az1pods" value="Pods (ACTIVE):&lt;br&gt;claim-processing · pas · ppmc&lt;br&gt;crm · policy · payment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="510" width="300" height="140" as="geometry"/>
        </mxCell>

        <!-- AZ2 inside -->
        <mxCell id="az2ing" value="nginx-ingress (AZ2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="430" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="az2pods" value="Pods (WARM, min=1):&lt;br&gt;same set — HPA scales&lt;br&gt;up on cutover" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="510" width="300" height="140" as="geometry"/>
        </mxCell>

        <!-- Stateful inside -->
        <mxCell id="sql" value="Cloud SQL PostgreSQL&lt;br&gt;REGIONAL HA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="770" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="Memorystore Redis&lt;br&gt;STANDARD_HA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="310" y="770" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pubsub" value="Pub/Sub&lt;br&gt;(global, zone-agnostic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="550" y="770" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Edges: callers -> stable -->
        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="apigee" target="stable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="direct" target="stable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="partners" target="stable"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Edges: stable -> AZ ingress -->
        <mxCell id="e4" value="active" style="endArrow=block;html=1;strokeColor=#3366cc;strokeWidth=2;fontColor=#3366cc;" edge="1" parent="1" source="stable" target="az1ing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="failover on health check (&lt;30s)" style="endArrow=block;html=1;dashed=1;strokeColor=#cc0000;strokeWidth=2;fontColor=#cc0000;" edge="1" parent="1" source="stable" target="az2ing"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ingress -> pods -->
        <mxCell id="e6" style="endArrow=block;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="az1ing" target="az1pods"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="az2ing" target="az2pods"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- pods -> stateful (shared) -->
        <mxCell id="e8" style="endArrow=block;html=1;strokeColor=#82b366;" edge="1" parent="1" source="az1pods" target="sql"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="az2pods" target="pubsub"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="seq" name="Failover Sequence">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="stitle" value="Auto-DR Failover Sequence (zero-touch)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="700" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="n0" value="NORMAL&#10;All callers → stable endpoint → AZ1 (healthy). AZ2 warm at 1 replica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="600" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ntrig" value="⚡ AZ1 zone fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="170" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="1 · Cloud SQL / Redis auto zone-failover (RPO ~ 0) — seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2 · Stable endpoint health check marks AZ1 unhealthy (~10s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3 · Endpoint steers ALL traffic → AZ2 warm pods (no restart, no URL change)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="390" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="4 · HPA scales AZ2 to real load; Pub/Sub subscriptions continue (shared prod-* topics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="460" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5 · Apigee callers + direct callers + partners: unchanged URL, ~20–30s blip → RTO &lt; 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="530" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fb" value="FAILBACK · AZ1 healthy for stable window → endpoint reverts to AZ1 primary; AZ2 → warm. Cooldown prevents flapping." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="620" width="600" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="a0" style="endArrow=block;html=1;" edge="1" parent="1" source="n0" target="ntrig"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1" style="endArrow=block;html=1;" edge="1" parent="1" source="ntrig" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="endArrow=block;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="endArrow=block;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" style="endArrow=block;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="s5" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell>
