<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="p1" name="1 · AI Product Lifecycle &amp; Requirements">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1_t" value="ENTERPRISE ASSISTANT (/assistant-pro) — AI Product Lifecycle &amp; Requirements.  Every AI program follows this loop; the rest of this atlas details each stage. Green = built &amp; running locally, amber dashed = planned." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="26" as="geometry"/></mxCell>

        <mxCell id="p1_s1" value="1. Business Problem&#10;A private, always-available personal AI assistant: chat + notes/reminders + document Q&amp;A + personal analytics — without personal data leaving the machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="p1_s2" value="2. Requirements&#10;Functional + Non-Functional (panels →). Written BEFORE any model talk — interviews expect this order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="165" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_s3" value="3. AI Feasibility&#10;Is GenAI the right tool? Data available? Risk acceptable? Local models capable enough? → PoC first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_s4" value="4. Model Selection&#10;Requirement matrix → shortlist → benchmark → weighted scorecard (Page 10). Outcome here: llama3.2 local default + cloud failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="335" width="290" height="66" as="geometry"/></mxCell>
        <mxCell id="p1_s5" value="5. Architecture&#10;Gateway → Orchestrator → Supervisor → specialist agents → data layer → LLM service (Page 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="426" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_s6" value="6. Development&#10;LangGraph graph, 5 sub-agents, guardrails, prompt registry, feedback loop — built additively, old assistant untouched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="511" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="p1_s7" value="7. Evaluation&#10;Deterministic tests (38, LIVE) + feedback-seeded golden dataset + RAGAS/DeepEval + LLM-as-judge (Page 11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_s8" value="8. Deployment&#10;Local processes today; Docker → K8s/Cloud Run; canary / blue-green / shadow (Page 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#d79b00;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="685" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_s9" value="9. Monitoring&#10;Structured logs + correlation IDs (LIVE) · LangFuse traces · drift detection · alerting (Page 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="770" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_s10" value="10. Continuous Improvement&#10;👍/👎 feedback → dataset → re-benchmark → prompt v2/v3 → redeploy. The loop back to stage 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="855" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="p1_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p1_s1" target="p1_s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p1_s2" target="p1_s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p1_s3" target="p1_s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p1_s4" target="p1_s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e5" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p1_s5" target="p1_s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e6" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p1_s6" target="p1_s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e7" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p1_s7" target="p1_s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e8" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p1_s8" target="p1_s9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e9" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="p1_s9" target="p1_s10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e10" value="loop" style="endArrow=block;html=1;dashed=1;strokeColor=#7e57c2;fontColor=#7e57c2;" edge="1" parent="1" source="p1_s10" target="p1_s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="500"/></Array></mxGeometry></mxCell>

        <mxCell id="p1_fr" value="FUNCTIONAL REQUIREMENTS (what it must do)&#10;&#10;• Chat with streaming + conversation history&#10;• Notes / tasks / reminders extraction (secretary)&#10;• Upload PDF / DOCX / media → searchable knowledge&#10;• Question-answering over own documents w/ citations&#10;• Personal analytics via natural language (NL2SQL)&#10;• Fresh web information with source URLs&#10;• Tool / API integrations (calendar, social, MCP)&#10;• Multi-agent workflows (supervisor routing)&#10;• Voice input/output (live in classic PA) · images (planned)&#10;• Human feedback on every answer (👍/👎)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="400" height="230" as="geometry"/></mxCell>
        <mxCell id="p1_nfr" value="NON-FUNCTIONAL REQUIREMENTS (targets to quote in interviews)&#10;&#10;Latency (P95)……………&lt; 2 sec interactive; streaming starts &lt; 1 sec&#10;Availability………………99.99% (≈ 52 min downtime / year)&#10;Scale………………………50,000 users (≈ 6 QPS avg, 60 QPS peak — see Page 2)&#10;Security…………………OAuth2 / SSO + RBAC (planned here; API open in dev)&#10;Compliance……………GDPR · SOC2 · HIPAA (regulated industries)&#10;Privacy……………………PII masking; local-first = data never leaves machine&#10;Cost…………………………&lt; $0.02 / request (local llama3.2 = $0 marginal)&#10;Quality……………………hallucination &lt; 2% · tool success &gt; 98% · JSON validity &gt; 99%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="400" height="220" as="geometry"/></mxCell>
        <mxCell id="p1_map" value="HOW THIS MAPS TO THE REAL BUILD (localhost:3001/assistant-pro)&#10;&#10;• Orchestrator = LangGraph supervisor graph — backend/app/graph/&#10;• Router/Supervisor = graph/supervisor.py (LLM + keyword fallback)&#10;• Memory = SQLite (pa_entries/pa_reminders) + Qdrant pa_memories&#10;• RAG = Qdrant doc_chunks, citations — agents/doc_chat + graph/nodes/rag.py&#10;• NL2SQL = agents/nl2sql (sqlglot guardrails, read-only engine)&#10;• Web search = core/web_search.py (Tavily→SearXNG→DuckDuckGo)&#10;• Tools = core/agent_loop.py (~25 tools) + MCP server :6789&#10;• LLM service = ai/registry.py (Ollama default, Claude/GPT/Gemini failover)&#10;• Feedback = assistant_feedback table + 👍/👎 in UI&#10;• Observability = structlog correlation IDs + optional LangFuse&#10;• Tests = backend/tests (38 deterministic tests)&#10;&#10;Interview line: &quot;I didn&#39;t just design this — I run it. Numbers below are from my build.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="70" width="430" height="300" as="geometry"/></mxCell>
        <mxCell id="p1_legend" value="HOW TO READ THIS ATLAS (applies to every page)&#10;&#10;■ green box…………LIVE — implemented, with file path&#10;▢ amber dashed……PLANNED — roadmap, honestly marked&#10;■ blue box……………process / service&#10;■ yellow box…………decision point&#10;■ teal box……………input / entry&#10;■ purple box…………output / result&#10;● numbered circle…request-flow order&#10;&#10;Panels (gray) hold the tables &amp; scripts you rehearse for interviews." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="390" width="430" height="230" as="geometry"/></mxCell>
        <mxCell id="p1_index" value="PAGE INDEX&#10;&#10;1  Lifecycle &amp; Requirements (this page)&#10;2  Discovery, ROI, Capacity &amp; Program Mgmt&#10;3  Enterprise Runtime Architecture (the big one)&#10;4  Request Flow &amp; Intent Routing&#10;5  Memory Architecture&#10;6  RAG Pipeline Deep-Dive&#10;7  NL2SQL Pipeline Deep-Dive&#10;8  Agents, Function Calling &amp; Frameworks&#10;9  Multi-Agent Sequence Diagram (worked example)&#10;10 Model Selection &amp; Benchmarking&#10;11 Evaluation, LLM-as-Judge &amp; Observability&#10;12 Deployment, Security, HA/DR &amp; LLMOps&#10;13 Whiteboard — Transformer &amp; LLM Internals&#10;14 Interview Playbook (scripts, trade-offs, STAR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1310" y="70" width="380" height="300" as="geometry"/></mxCell>
        <mxCell id="p1_quote" value="INTERVIEW RULE #1&#10;&#10;Never start with the model.&#10;Start with the business problem, then requirements, then feasibility — model selection is stage 4, not stage 1.&#10;&#10;&quot;We picked GPT because it&#39;s the best&quot; = instant red flag." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="390" width="380" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p2" name="2 · Discovery · ROI · Capacity · Program Mgmt">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2_t" value="AI PRODUCT DISCOVERY &amp; PROGRAM MANAGEMENT — the manager layer: ROI, build-vs-buy, cost &amp; capacity math, team, timeline, risks, go-live. Interviewers test whether you think in business terms BEFORE architecture." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="26" as="geometry"/></mxCell>

        <mxCell id="p2_roi" value="ROI CALCULATION (worked example)&#10;&#10;Value side (per year):&#10;• 500 support agents × 30 min saved/day × $25/hr ≈ $1.56M&#10;• Faster answers → +2% CSAT → churn reduction ≈ $400k&#10;• Total value ≈ $1.9M / yr&#10;&#10;Cost side (per year):&#10;• Build: 6-person team × 6 months ≈ $450k (one-off)&#10;• Run: LLM tokens ≈ $180k + infra $120k + team $300k = $600k/yr&#10;&#10;ROI year-1 ≈ (1.9M − 1.05M) / 1.05M ≈ 80% · payback ≈ 7 months&#10;&#10;Rule: quote value drivers (time saved, deflection rate, error&#10;reduction), never &quot;AI is cool&quot;. Measure with an A/B pilot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="400" height="290" as="geometry"/></mxCell>
        <mxCell id="p2_bvb" value="BUILD vs BUY DECISION MATRIX&#10;&#10;BUY (ChatGPT Enterprise / Copilot / Gemini for Workspace) when:&#10;• Generic productivity use-case, no proprietary data flows&#10;• Speed-to-value beats differentiation · small team&#10;&#10;BUILD (this platform&#39;s path) when:&#10;• Data cannot leave your boundary (privacy / regulation)&#10;• Deep integration with own DBs, tools, workflows&#10;• Routing/cost control across models is a differentiator&#10;&#10;HYBRID (most enterprises): buy the model API,&#10;build the orchestration + RAG + guardrails + eval layer.&#10;&#10;Decision inputs: TCO 3yr · differentiation · data sensitivity ·&#10;team capability · vendor lock-in risk · time-to-market" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="400" height="290" as="geometry"/></mxCell>
        <mxCell id="p2_cost" value="COST ESTIMATION — TOKEN ECONOMICS&#10;&#10;Formula:  tokens/request × requests/day × $/1k tokens = daily cost&#10;&#10;Example (cloud): 3k tokens/req (prompt+context+answer)&#10;× 500k req/day × $0.005/1k ≈ $7.5k/day ≈ $225k/month&#10;&#10;Levers to cut cost (in order of impact):&#10;1. Route simple queries to small/cheap models (model gateway)&#10;2. Cache: responses, embeddings, FAQ, SQL schemas&#10;3. Trim context (retrieval top-k, history windows)&#10;4. Prompt caching / KV-cache reuse (up to 90% input discount)&#10;5. Local models for private + high-volume flows ($0 marginal —&#10;    this build&#39;s default: llama3.2 on-device)&#10;&#10;LIVE: every call recorded in token_usage table w/ cost." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="400" height="290" as="geometry"/></mxCell>
        <mxCell id="p2_cap" value="CAPACITY PLANNING (the math interviewers want on the board)&#10;&#10;Users → QPS:  50,000 users × 10 req/day ÷ 86,400s ≈ 5.8 QPS avg&#10;Peak = 10× avg ≈ 60 QPS · concurrent sessions ≈ 2–5% of DAU ≈ 1–2.5k&#10;&#10;LLM throughput: one A100/H100 ≈ 1–3k tokens/s (7B–13B, batched).&#10;60 QPS × 800 output tokens ≈ 48k tokens/s → ~20–40 GPUs OR&#10;cloud API (no GPU ops) OR aggressive routing/caching to shrink it.&#10;&#10;Sizing rules:&#10;• Stateless app tier: HPA on CPU/RPS — trivial to scale&#10;• LLM tier is the bottleneck: batch, quantize, route, cache&#10;• Vector DB: memory ≈ vectors × dim × 4B (+ quantization ÷4)&#10;• Redis for sessions; DB connections pooled&#10;&#10;Always state assumptions out loud — the method beats the number." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="60" width="390" height="290" as="geometry"/></mxCell>

        <mxCell id="p2_team" value="TEAM STRUCTURE (8–10 people typical)&#10;&#10;• AI Product Manager — use-cases, KPIs, feedback triage&#10;• AI Architect / Tech Lead — this atlas is their artifact&#10;• 2–3 ML/Agent Engineers — orchestrator, agents, prompts&#10;• Data Engineer — ingestion, KB lifecycle, schemas&#10;• Platform/SRE — gateway, K8s, observability, cost&#10;• QA / Eval Engineer — golden datasets, RAGAS, regression&#10;• (part-time) Security + Legal/Compliance review&#10;&#10;RACI hint: PM = Accountable for outcomes, Architect =&#10;Responsible for design, Security = Consulted, Leadership = Informed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="p2_time" value="TIMELINE &amp; SPRINTS (phased, each independently shippable)&#10;&#10;Phase 0 · 2 wks — Discovery: use-cases, data audit, ROI model&#10;Phase 1 · 4 wks — PoC: one route end-to-end (RAG chat w/ citations),&#10;                     eval dataset v0, go/no-go gate&#10;Phase 2 · 6 wks — Pilot: supervisor + all routes, feedback loop,&#10;                     50 users, weekly eval reports&#10;Phase 3 · 6 wks — Hardening: auth, guardrails, load tests,&#10;                     observability, security review&#10;Phase 4 · 2 wks — GA rollout: canary 5% → 25% → 100%&#10;&#10;This build followed the same shape: assistant-pro shipped&#10;additively next to the old assistant (zero-risk rollout)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="380" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="p2_risk" value="RISK REGISTER (likelihood × impact → mitigation)&#10;&#10;Hallucination in production…M×H → grounding + citations + eval&#10;   gates + &lt;2% target + HITL for high-risk answers&#10;Cost overrun…………………M×M → token budgets, routing, caching,&#10;   per-user quotas, weekly cost review (token_usage LIVE)&#10;Data leakage / PII…………L×H → local-first default, PII masking&#10;   before cloud failover, DLP review, audit logs&#10;Vendor lock-in………………M×M → provider registry abstraction&#10;   (LIVE: swap Ollama/Claude/GPT/Gemini via config)&#10;Low adoption…………………M×H → pilot champions, feedback loop,&#10;   latency &lt;2s, measure task completion not logins&#10;Prompt injection……………M×H → untrusted-content rules, tool&#10;   allowlists, output validation (Page 12)&#10;Model deprecation…………H×L → eval harness re-runs on new models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="380" width="400" height="290" as="geometry"/></mxCell>
        <mxCell id="p2_golive" value="STAKEHOLDERS &amp; GO-LIVE CHECKLIST&#10;&#10;Stakeholders: sponsor (budget) · legal/compliance (data) ·&#10;security (pen test) · support (escalation path) · end-user champions&#10;&#10;GO-LIVE GATE — all must be ✓:&#10;□ Eval suite green + golden-dataset scores ≥ targets&#10;□ Load test at 2× peak QPS passed&#10;□ Security review: authn/authz, OWASP-LLM, injection tests&#10;□ PII handling + data-retention policy signed off&#10;□ Observability: dashboards, alerts, on-call runbook&#10;□ Rollback tested (model/prompt/config revert &lt; 5 min)&#10;□ Human escalation path for wrong answers&#10;□ Cost alerts armed (daily budget threshold)&#10;□ Canary plan approved (5% → 25% → 100%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="380" width="390" height="290" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3" name="3 · Enterprise Runtime Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3_t" value="ENTERPRISE RUNTIME ARCHITECTURE — every layer of the reference stack, mapped to the live build. Spine top→bottom = one request. Green = LIVE (file path shown) · amber dashed = PLANNED." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="26" as="geometry"/></mxCell>

        <mxCell id="p3_user" value="User — Web / Mobile App&#10;React SPA AssistantPro.tsx: streaming chat, route badges, citations, 👍/👎, WS reconnect + offline queue + 25s ping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="480" height="56" as="geometry"/></mxCell>
        <mxCell id="p3_auth" value="Authentication — OAuth2/SSO + JWT&#10;PLANNED — validate BEFORE websocket.accept(), close 4401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#d79b00;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="320" height="52" as="geometry"/></mxCell>
        <mxCell id="p3_gw" value="Load Balancer + API Gateway (Apigee/Kong/NGINX)&#10;PLANNED — rate limits 10r/s, WS upgrade · today: Vite dev proxy :3001→:8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#d79b00;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="150" width="380" height="52" as="geometry"/></mxCell>
        <mxCell id="p3_be" value="AI Backend (FastAPI)&#10;routers/assistant_pro.py — WS /ws/assistant-pro (thinking/token/response frames), REST /api/assistant-pro/feedback + /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="236" width="480" height="56" as="geometry"/></mxCell>
        <mxCell id="p3_orch" value="AI ORCHESTRATOR — LangGraph StateGraph&#10;graph/graph.py · run_turn() · AsyncSqliteSaver checkpointer, thread_id = session_id → conversation survives restarts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="330" y="326" width="480" height="56" as="geometry"/></mxCell>

        <mxCell id="p3_conv" value="Conversation Manager&#10;checkpointed messages channel + pa_conversations history (shared with classic PA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="250" height="62" as="geometry"/></mxCell>
        <mxCell id="p3_rt" value="Router / Supervisor&#10;graph/supervisor.py — one LLM call → {route, plan, reason}; keyword regex fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="420" width="250" height="62" as="geometry"/></mxCell>
        <mxCell id="p3_ms" value="Memory Service&#10;SQLite short-term + Qdrant pa_memories semantic (2.5s timeout guard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="250" height="62" as="geometry"/></mxCell>
        <mxCell id="p3_pm" value="Prompt Manager&#10;core/prompt_registry.py — versioned AgentPrompt objects (nl2sql_generator @ v2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="870" y="420" width="250" height="62" as="geometry"/></mxCell>

        <mxCell id="p3_intent" value="INTENT CLASSIFICATION — route to exactly one specialist (memory | rag | web_search | nl2sql | tools)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1" vertex="1" parent="1"><mxGeometry x="330" y="520" width="480" height="44" as="geometry"/></mxCell>

        <mxCell id="p3_a1" value="Memory Agent&#10;graph/nodes/memory.py — notes, reminders, secretary chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="205" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_a2" value="RAG Agent&#10;graph/nodes/rag.py — cited answers over uploaded docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="285" y="600" width="205" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_a3" value="Web Search Agent&#10;graph/nodes/web_search.py — [n] URL citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="510" y="600" width="205" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_a4" value="NL2SQL Agent&#10;graph/nodes/nl2sql.py — guarded SELECT analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="735" y="600" width="205" height="58" as="geometry"/></mxCell>
        <mxCell id="p3_a5" value="Tool / Agent Engine&#10;core/agent_loop.py — 25-iteration loop, parallel dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="960" y="600" width="205" height="58" as="geometry"/></mxCell>

        <mxCell id="p3_d1" value="Vector DB — Qdrant :6333&#10;pa_memories · doc_chunks (tenant-partitioned, int8) · code_chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="170" y="700" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="p3_d2" value="SQL DB — SQLite (read-only engine for NL2SQL, mode=ro)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="430" y="700" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="p3_d3" value="Search APIs&#10;Tavily → SearXNG :8081 → DuckDuckGo (zero-config)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="690" y="700" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="p3_d4" value="External APIs / MCP :6789&#10;calendar · social · extraction · calc-service :8787" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="950" y="700" width="230" height="56" as="geometry"/></mxCell>

        <mxCell id="p3_llm" value="LLM SERVICE / MODEL GATEWAY — ai/registry.py + ai/completion.py&#10;Ollama llama3.2 default ($0, private) → failover Claude / GPT / Gemini when keys exist.&#10;Routing strategy: simple→small model · reasoning→large · coding→specialized · vision→multimodal · per-route overrides in config.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="330" y="796" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="p3_cache" value="Caching (Redis)&#10;embeddings · FAQ answers · prompt templates · SQL schemas (LIVE: cached DDL) · responses — cuts latency AND token cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="990" y="796" width="290" height="70" as="geometry"/></mxCell>

        <mxCell id="p3_stream" value="STREAMING RESPONSE — token deltas over WS (graph/callbacks.py registry) → route badge + citations + actions + message_id in final frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="906" width="620" height="50" as="geometry"/></mxCell>
        <mxCell id="p3_eval" value="Evaluation &amp; Monitoring&#10;structlog correlation IDs + 38 tests (LIVE) · LangFuse traces (opt-in) · RAGAS/DeepEval (PLANNED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="996" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="p3_ana" value="Analytics &amp; Feedback&#10;assistant_feedback 👍/👎 (LIVE) → golden dataset · token_usage cost table (LIVE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="740" y="996" width="380" height="60" as="geometry"/></mxCell>

