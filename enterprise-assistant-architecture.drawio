        <mxCell id="p3_e21" style="endArrow=block;html=1;strokeColor=#34a853;" edge="1" parent="1" source="p3_d2" target="p3_llm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_e22" style="endArrow=block;html=1;strokeColor=#34a853;" edge="1" parent="1" source="p3_d3" target="p3_llm"><mxGeometry relative="1" as="geometry"/></mxCell>
