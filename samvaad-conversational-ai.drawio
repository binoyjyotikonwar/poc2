        <mxCell id="s4_je3" style="endArrow=block;html=1;strokeColor=#f9a825;" edge="1" parent="1" source="s4_p3" target="s4_j6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s4_ai" value="AI &amp; SAFETY SERVICES&#10;&#10;Vertex AI — Gemini 2.5 Flash&#10;(PruGenAI · asia-south1)&#10;Vertex AI Search (RAG)&#10;Vision / OCR (Gemini extraction)&#10;Model Armor (inbound / outbound)&#10;&#10;← agent-mediated, screened model call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#7e57c2;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1010" y="290" width="240" height="180" as="geometry"/></mxCell>
        <mxCell id="s4_sql" value="Conversation &amp; Domain Data — Cloud SQL&#10;(Postgres, via GraphQL layer + Cloud SQL Auth Proxy)&#10;Sessions · conversation_logs (redacted) · Audit · Party · Policy · Claims · Payment · PII · PHI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1a73e8;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1010" y="490" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="s4_redis" value="Memorystore for Redis&#10;(ADK session · cache)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00897b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="630" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="s4_gcs" value="Document Store — GCS&#10;(v4 signed URLs) · data layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="700" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="s4_de1" value="agent-mediated, screened model call" style="endArrow=block;html=1;strokeColor=#7e57c2;fontSize=9;" edge="1" parent="1" source="s4_j6" target="s4_ai"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4_de2" style="endArrow=block;html=1;strokeColor=#1a73e8;" edge="1" parent="1" source="s4_j1" target="s4_sql"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4_de3" style="endArrow=block;html=1;strokeColor=#00897b;" edge="1" parent="1" source="s4_p3" target="s4_redis"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s4_pru" value="WITHIN PruGCP (intranet · Nginx Ingress)&#10;&#10;TCS BaNCS (Policy Admin / PAS)&#10;SimpleCRM&#10;Party Mgmt / PIS · FileNet (docs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#5f6368;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="290" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="s4_part" value="PARTNER SYSTEMS (outside PHI GCP · via Apigee — mTLS + token)&#10;&#10;Genesys (live-agent escalation)&#10;Digio / Karza (KYC / eSign)&#10;Payment Gateways (Razorpay / ICICI / BillDesk)&#10;Communication Providers (Twilio / SMS / Email · OTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#5f6368;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="440" width="220" height="180" as="geometry"/></mxCell>
        <mxCell id="s4_de4" value="policy / claims / party" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=9;" edge="1" parent="1" source="s4_j1" target="s4_pru"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4_de5" value="via Apigee — mTLS + token" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=9;" edge="1" parent="1" source="s4_j3" target="s4_part"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4_de6" value="live-agent handover" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=9;" edge="1" parent="1" source="s4_j8" target="s4_part"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s4_e1" value="channel" style="endArrow=block;html=1;strokeColor=#25D366;fontSize=9;" edge="1" parent="1" source="s4_user" target="s4_ch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4_e2" style="endArrow=block;html=1;strokeColor=#7e57c2;" edge="1" parent="1" source="s4_ch" target="s4_waf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4_e3" style="endArrow=block;html=1;strokeColor=#E64A19;" edge="1" parent="1" source="s4_waf" target="s4_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4_e4" style="endArrow=block;html=1;strokeColor=#1a73e8;" edge="1" parent="1" source="s4_api" target="s4_ing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4_e5" style="endArrow=block;html=1;strokeColor=#f9a825;" edge="1" parent="1" source="s4_ing" target="s4_p1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s4_leg" value="NOTES&#10;&#10;• End customers never access backend or partner APIs directly — everything flows through the workload layer&#10;• Journeys are executed by sub-agents through the governed tool registry (risk-classified; destructive actions require confirmation; idempotent)&#10;• Data layer: Redis = session (24h TTL) · Cloud SQL = durable redacted logs + domain data · GCS = documents via 60-min signed URLs&#10;• Partner calls leave via Apigee with mTLS + token — never direct from the agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1010" y="790" width="700" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="s5" name="5 · Security &amp; AI-Safety Controls">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s5_t" value="SAMVAAD — SECURITY-BY-DESIGN, DEFENCE-IN-DEPTH. Seven control planes wrap every conversation turn; AI-safety screening happens BEFORE any LLM call and AFTER every response. This page is the security story for architecture reviews and interviews." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="26" as="geometry"/></mxCell>

        <mxCell id="s5_c1" value="1 · CHANNEL AUTHENTICITY&#10;&#10;• Twilio/BSP webhook signature verification on every request&#10;• Only the approved WhatsApp Business channel — no other ingress&#10;• Dedup / replay protection on message IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="s5_c2" value="2 · PERIMETER CONTROLS&#10;&#10;• Imperva WAF / DDoS / bot &amp; abuse (outside the cloud org)&#10;• Apigee: OAuth, rate limiting, threat protection, request validation&#10;• Google Cloud Armor (WAAP) on the Global HTTPS LB&#10;• Workload not internet-published; restricted ingress GKE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="s5_c3" value="3 · APPLICATION CONTROLS&#10;&#10;• Input validation · session controls · secure error handling&#10;• Feature flags + KILL SWITCHES (per journey / global)&#10;• Rate limiters (per user / per session) in Redis&#10;• Webhook ACK &lt; 5s; async processing; min-instances 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="s5_c4" value="4 · IDENTITY &amp; TRANSACTION CONTROLS&#10;&#10;• OTP verification (SAMVAAD_LOGIN · SMS)&#10;• Registered vs unregistered routing (capability gating)&#10;• Object-level authorisation / ANTI-IDOR — you can only touch&#10;   YOUR policy/claim objects&#10;• Tool RISK CLASSIFICATION in the ~140-tool registry&#10;• Destructive-action confirmation · idempotency keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="60" width="390" height="170" as="geometry"/></mxCell>

        <mxCell id="s5_c5" value="5 · AI CONTROLS (the differentiator)&#10;&#10;• Model Armor INBOUND — prompt-injection / jailbreak screening, RAI&#10;   (responsible-AI) categories, malicious-URI detection — BEFORE any model call&#10;• Model Armor OUTBOUND — response screening + output redaction&#10;• RAG source restriction — retrieval scoped to the VERIFIED policyholder&#10;   and approved knowledge sources only; grounded-only answers&#10;• Unsafe-content blocking · multi-language handling&#10;• Deterministic-first: ~95% of turns never reach the LLM at all&#10;• LLM is agent-mediated: never free-form, never talks to backends directly&#10;• Human escalation — Grievance &amp; live-agent handover (Genesys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#7e57c2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="620" height="230" as="geometry"/></mxCell>
        <mxCell id="s5_c6" value="6 · DATA-PROTECTION CONTROLS&#10;&#10;• PII/PHI REDACTION + minimisation — redaction happens before&#10;   the model sees text and before logs are written&#10;• No unnecessary PHI sent to the LLM · no sensitive data used to&#10;   train foundation models&#10;• Masked / hashed identifiers in logs (log-redaction test suite)&#10;• conversation_logs stored REDACTED in Cloud SQL (pgAudit, CMEK,&#10;   PITR, private IP)&#10;• GCS documents via v4 signed URLs (60-min expiry)&#10;• Secrets: Secret Manager / Vault at runtime · Workload Identity —&#10;   no keys in the container image&#10;• Retention aligned to PHI / Group requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="220" width="600" height="230" as="geometry"/></mxCell>
        <mxCell id="s5_c7" value="7 · OPERATIONAL CONTROLS&#10;&#10;• Structured audit logs with CORRELATION /&#10;   SESSION / TURN IDs (structlog JSON + OTEL)&#10;• Model Armor + guardrail VERDICT logs&#10;• Cloud Logging / Monitoring / Trace ·&#10;   Managed Prometheus&#10;• Monitoring &amp; alerting · incident response ·&#10;   runbooks · kill-switch drills&#10;• GovOps: observability system-of-record,&#10;   FinOps &amp; AI-agent governance alignment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="250" width="390" height="200" as="geometry"/></mxCell>

        <mxCell id="s5_turn" value="ONE TURN THROUGH THE CONTROLS (say it in order)&#10;&#10;WhatsApp msg → ① signature verified → ② perimeter (WAF/Apigee/Armor) → ③ app gates (kill-switch, rate-limit, dedup) →&#10;⑥ PII/PHI redacted → ⑤ Model Armor INBOUND → ④ identity/OTP + anti-IDOR → ADK routes (deterministic-first, ~95% no LLM) →&#10;[if needed] agent-mediated Gemini call, RAG scoped to the verified policyholder → ⑤ Model Armor OUTBOUND + output redaction →&#10;⑦ audited (correlation/session/turn IDs) → safe reply to WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1240" height="140" as="geometry"/></mxCell>

        <mxCell id="s5_cicd" value="CI/CD SECURITY GATES (shift-left)&#10;&#10;• GitHub: PR change control · CODEOWNERS ·&#10;   protected branches&#10;• Checkmarx SAST / SCA / CSEC + DAST —&#10;   Critical/High fixed before release (DAR gate)&#10;• detect-secrets pre-commit&#10;• 1,100+ pytest tests (239 files) as required&#10;   PR check — incl. guardrails, content-safety,&#10;   kill-switch, rate-limiter, anti-IDOR, log-redaction&#10;• EvaCon conversation tests (real pipeline E2E)&#10;• IaC: Terraform/ISS GCP blueprints (PR-based)&#10;• Model Armor template provisioning automated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="480" width="390" height="280" as="geometry"/></mxCell>

        <mxCell id="s5_int" value="INTERVIEW FRAMING — why this design is strong&#10;&#10;1. &quot;The LLM is a component, not the system&quot; — bounded, screened, agent-mediated. Most turns never touch it.&#10;   That single sentence answers cost, latency, safety and auditability at once.&#10;2. &quot;Redact before the model, redact before the logs&quot; — PII/PHI protection is positional, not aspirational.&#10;3. &quot;Every tool is risk-classified and ownership-checked&quot; — agency is governed (anti-IDOR, confirmation, idempotency).&#10;4. &quot;Inbound AND outbound screening&quot; — Model Armor wraps the model on both sides (prompt injection in, leakage out).&#10;5. &quot;Kill switches + feature flags per journey&quot; — you can turn OFF a capability in production instantly.&#10;6. &quot;Grounded-only answers, retrieval scoped to the verified policyholder&quot; — RAG is an authorisation boundary, not just relevance.&#10;7. &quot;1,100+ tests including security suites, as a required PR gate&quot; — controls are executable, not documentation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1240" height="230" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="s6" name="6 · AI Deep-Dive — ADK Orchestration, Routing &amp; Memory">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s6_t" value="SAMVAAD AI DEEP-DIVE — ADK AGENT ORCHESTRATION, ROUTING &amp; MEMORY. The agentic core: a ROOT agent routes deterministically first, delegates to 14 specialised sub-agents, and every action goes through a governed, risk-classified ~140-tool registry." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="26" as="geometry"/></mxCell>

        <mxCell id="s6_f1" value="Customer turn arrives&#10;(post inbound-safety, redacted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="s6_f2" value="ADK ROOT AGENT (orchestrator)&#10;session context from Redis · registered vs unregistered capability gating" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="140" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s6_f3" value="DETERMINISTIC-FIRST ROUTER&#10;menu / interactive-list selections, structured slots, exact intents → direct handler, NO LLM (~95% of turns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="230" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="s6_f4" value="Sub-agent delegation (14 specialists)&#10;Policy Servicing · Claims · Payments &amp; Auto-debit · KYC/Identity · Nominee · Policy Q&amp;A (RAG) · Knowledge/FAQ · Grievance/Handover · …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="s6_f5" value="GOVERNED TOOL REGISTRY (~140 tools)&#10;risk-classified · object-ownership / anti-IDOR checked · authorised backend calls only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;fontSize=11;align=left;spacingLeft=6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="440" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="s6_f6" value="Bounded Gemini call (only if needed)&#10;reasoning / extraction / language — agent-mediated, Model-Armor-screened" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="s6_f7" value="Response assembled → outbound safety → safe WhatsApp reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="s6_e1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="s6_f1" target="s6_f2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6_e2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="s6_f2" target="s6_f3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6_e3" value="complex turn" style="endArrow=block;html=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1" source="s6_f3" target="s6_f4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6_e4" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="s6_f4" target="s6_f5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6_e5" value="bounded reasoning needed" style="endArrow=block;html=1;dashed=1;strokeColor=#7e57c2;fontSize=10;" edge="1" parent="1" source="s6_f5" target="s6_f6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6_e6" style="endArrow=block;html=1;strokeColor=#7e57c2;" edge="1" parent="1" source="s6_f6" target="s6_f7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6_e7" value="deterministic reply (~95%)" style="endArrow=block;html=1;strokeColor=#34a853;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="s6_f3" target="s6_f7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="480"/></Array></mxGeometry></mxCell>

        <mxCell id="s6_det" value="WHY DETERMINISTIC-FIRST (the headline design decision)&#10;&#10;~95% of turns never invoke the LLM: menu/list selections, structured slot filling,&#10;direct tool execution against backends.&#10;&#10;• COST — no tokens burned on &quot;show my policy&quot; clicks&#10;• LATENCY — handler + tool call beats any model round-trip&#10;• SAFETY — a turn that never reaches the model cannot hallucinate,&#10;   cannot be prompt-injected, cannot leak&#10;• AUDITABILITY — deterministic paths are exactly reproducible&#10;&#10;The LLM is reserved for what genuinely needs it: free-text understanding,&#10;extraction from documents/images, language generation — always bounded,&#10;always screened, always agent-mediated.&#10;&#10;Interview line: &quot;We treat the LLM as a scarce, screened specialist —&#10;not as the front door.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="440" height="320" as="geometry"/></mxCell>

        <mxCell id="s6_tool" value="TOOL RISK CLASSIFICATION (governed agency)&#10;&#10;READ / low-risk……………policy status, claim track, FAQ → direct execution&#10;WRITE / medium……………update nominee, contact → OTP-verified session +&#10;   ownership check (anti-IDOR)&#10;DESTRUCTIVE / high………auto-debit changes, cancellations → explicit&#10;   confirmation step + idempotency keys + audit&#10;&#10;Every tool call: object-ownership validated (your policy only),&#10;correlation/session/turn IDs logged, backend reached only via&#10;VPC → Apigee (mTLS + token) — the agent has NO ambient authority." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="440" height="230" as="geometry"/></mxCell>

        <mxCell id="s6_mem" value="MEMORY MODEL (privacy-by-design)&#10;&#10;SESSION (working) memory — Memorystore Redis · ADK session state ·&#10;24h TTL · rediss/TLS+AUTH · reconstructable, NOT a system of record&#10;&#10;DURABLE record — Cloud SQL Postgres: conversation_logs stored&#10;REDACTED · transcript outbox · pgAudit · CMEK · PITR&#10;&#10;KNOWLEDGE — governed RAG corpus in Vertex AI Search (approved&#10;sources only), NOT learned from user chats&#10;&#10;Deliberate absence: NO long-term vector memory of customer&#10;conversations — a privacy-by-design choice for insurance. Contrast&#10;with a personal assistant (assistant-pro) where semantic memory of&#10;the user IS the feature. Know when each is right.&#10;&#10;Nudge queues + rate-limit + kill-switch counters also live in Redis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="60" width="420" height="320" as="geometry"/></mxCell>

        <mxCell id="s6_fw" value="FRAMEWORK CONTEXT — ADK vs the alternatives&#10;&#10;Google ADK (used by Samvaad) — in-process agent runtime; root/sub-agent&#10;hierarchy; tool registry; Vertex-native (Gemini, Model Armor, Search);&#10;fits a GCP-standardised enterprise.&#10;LangGraph (used in assistant-pro) — explicit state-machine graphs,&#10;conditional edges, checkpointing; maximal control-flow control;&#10;framework-agnostic models.&#10;CrewAI / AutoGen — role-crews / conversational multi-agent; faster to&#10;prototype, less production control.&#10;&#10;Same architecture pattern in BOTH builds: supervisor/root routes to&#10;specialists acting through governed tools — the framework is the&#10;implementation detail, the PATTERN is the answer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="400" width="420" height="290" as="geometry"/></mxCell>

        <mxCell id="s6_map" value="CONCEPT MAP — enterprise reference layer → Samvaad implementation&#10;&#10;AI Orchestrator………………ADK root agent (in-process runtime on GKE)&#10;Router / Intent classifier……deterministic-first router + registered/unregistered gating&#10;Conversation Manager………Redis ADK session (24h) + redacted Cloud SQL logs&#10;Memory Service………………session-only by design (no long-term user vectors)&#10;Prompt Manager………………agent/tool configs in repo (PR-reviewed, versioned via Git)&#10;RAG………………………………Vertex AI Search, retrieval scoped to verified policyholder&#10;NL2SQL…………………………not used — structured backends via typed tools (safer than SQL-gen in insurance)&#10;Function calling / tools………~140-tool registry, risk-classified, anti-IDOR&#10;Model gateway…………………Vertex AI enterprise platform (Gemini 2.5 Flash)&#10;Guardrails………………………Model Armor INBOUND + OUTBOUND + content gates&#10;Evaluation………………………1,100+ pytest + EvaCon conversation tests (CI-gated)&#10;Human feedback / HITL………grievance → Genesys live-agent handover&#10;Observability……………………Cloud Logging/Trace + OTEL + correlation/session/turn IDs&#10;Deployment……………………GKE multi-zone + active-passive DR (Page 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="60" width="390" height="420" as="geometry"/></mxCell>
        <mxCell id="s6_note" value="NOTE — why no NL2SQL here&#10;&#10;assistant-pro generates SQL because the user owns&#10;all their data. In insurance, customer analytics run&#10;through TYPED, permission-checked tools against&#10;domain APIs — generated SQL would widen the&#10;attack surface for zero benefit. Saying this&#10;trade-off out loud is a senior-architect answer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="500" width="390" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="s7" name="7 · AI Deep-Dive — RAG, Model Platform &amp; Evaluation">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s7_t" value="SAMVAAD AI DEEP-DIVE — RAG (grounding), MODEL PLATFORM (why Gemini 2.5 Flash) &amp; EVALUATION. Key insight: retrieval is scoped to the VERIFIED policyholder — RAG is an AUTHORIZATION boundary, not just a relevance mechanism." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="26" as="geometry"/></mxCell>

        <mxCell id="s7_r1" value="Customer question&#10;&quot;What does my policy cover for flood damage?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="300" height="52" as="geometry"/></mxCell>
        <mxCell id="s7_r2" value="Identity check first&#10;OTP-verified session (SAMVAAD_LOGIN) — unverified users get only public knowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="142" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s7_r3" value="Vertex AI Search (Discovery Engine)&#10;retrieval over APPROVED knowledge sources only · text-embedding-005 · retrieval SCOPED to the verified policyholder&#39;s products/documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="232" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="s7_r4" value="Grounded generation (Gemini 2.5 Flash)&#10;agent-mediated · Model-Armor-screened · GROUNDED-ONLY: answers only from retrieved sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="338" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="s7_r5" value="Outbound screening + redaction → safe, sourced answer to WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="434" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="s7_re1" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="s7_r1" target="s7_r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s7_re2" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="s7_r2" target="s7_r3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s7_re3" style="endArrow=block;html=1;strokeColor=#5f6368;" edge="1" parent="1" source="s7_r3" target="s7_r4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s7_re4" style="endArrow=block;html=1;strokeColor=#7e57c2;" edge="1" parent="1" source="s7_r4" target="s7_r5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s7_doc" value="DOCUMENT / IMAGE PIPELINE&#10;&#10;WhatsApp media (≤ 8 MB) → Cloud Vision image-safety&#10;screen → Gemini Vision / OCR extraction (bounded task)&#10;→ structured fields into the journey (e.g. claim doc&#10;submit) → stored in GCS, accessed via v4 signed URLs&#10;(60-min expiry) — the customer never gets a raw&#10;bucket path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="300" height="200" as="geometry"/></mxCell>

        <mxCell id="s7_model" value="MODEL SELECTION — WHY GEMINI 2.5 FLASH ON VERTEX AI (the manager answer)&#10;&#10;1. ENTERPRISE PLATFORM, not raw API — Vertex AI within PHI GCP: data stays in-tenancy,&#10;    NO customer data used to train foundation models (contractual), asia-south1 residency&#10;    (India data-locality for insurance)&#10;2. NATIVE SAFETY INTEGRATION — Model Armor (inbound/outbound screening) is a&#10;    first-class Vertex capability; one platform for model + guardrails + audit&#10;3. FLASH TIER FITS THE JOB — the LLM does bounded reasoning/extraction, not long-form&#10;    generation → Flash&#39;s latency + cost profile beats a larger model for ~5% of turns&#10;4. PruGenAI-APPROVED — the PHI-governed version of the model; org-level compliance&#10;    already cleared (TAC/TDWG endorsed)&#10;5. ECOSYSTEM — same platform provides Vertex AI Search (RAG), Vision/OCR,&#10;    text-embedding-005 — one vendor boundary, one IAM story, one bill&#10;&#10;Trade-off acknowledged: platform lock-in vs operational simplicity + compliance —&#10;in a regulated insurer, the compliance-cleared managed platform wins. The agent&#10;runtime (ADK) keeps the model swappable if that changes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="620" height="330" as="geometry"/></mxCell>

        <mxCell id="s7_hall" value="HALLUCINATION CONTROLS (layered — say them in order)&#10;&#10;1. ~95% of turns are deterministic — they CANNOT hallucinate&#10;2. Grounded-only generation — answers restricted to retrieved,&#10;    approved sources (RAG source restriction)&#10;3. Retrieval scoped to the verified policyholder — wrong-customer&#10;    answers are structurally impossible (authorization boundary)&#10;4. Model Armor OUTBOUND — response screening + output redaction&#10;5. Unsafe-content blocking + refusal paths&#10;6. Human escalation — grievance / live-agent (Genesys) for anything&#10;    the system shouldn&#39;t answer&#10;7. EvaCon conversation tests regression-check real dialog flows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="410" width="620" height="240" as="geometry"/></mxCell>

        <mxCell id="s7_eval" value="EVALUATION &amp; QUALITY (executable controls, not documentation)&#10;&#10;UNIT / SECURITY SUITES — 1,100+ pytest across 239 files, REQUIRED&#10;check on every PR/merge. Security suites include: guardrails,&#10;content-safety, kill-switch, rate-limiter, anti-IDOR ownership,&#10;log-redaction.&#10;&#10;CONVERSATION TESTS — EvaCon: wire-visible, real-pipeline&#10;end-to-end scenario checks (the conversational equivalent of&#10;integration tests).&#10;&#10;SECURITY SCANNING — Checkmarx SAST/SCA/CSEC + DAST +&#10;detect-secrets; Critical/High remediated before release (DAR gate).&#10;&#10;RUNTIME SAFETY TELEMETRY — Model Armor + guardrail VERDICT&#10;LOGS: every screening decision recorded → ongoing safety&#10;monitoring + tuning dataset.&#10;&#10;GOVOPS — observability as system-of-record, FinOps cost&#10;governance, AI-agent governance alignment (org-level)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="60" width="640" height="330" as="geometry"/></mxCell>

        <mxCell id="s7_ops" value="OPS &amp; LATENCY ENGINEERING&#10;&#10;• Twilio webhook SLA — ACK &lt; 5s: return HTTP 200 immediately,&#10;   process the agent turn ASYNCHRONOUSLY (queue + reply push)&#10;• min-instances 2 — warm containers, no cold-start penalty&#10;• Flash-tier model — lowest-latency Gemini class for the few&#10;   turns that need a model&#10;• Redis — session reads + caches + rate counters at memory speed&#10;• Deterministic majority — most turns are handler-speed, not&#10;   model-speed&#10;• Kill switches + feature flags per journey — degrade gracefully&#10;   instead of failing loudly&#10;• GKE autoscaling multi-zone — load and zone failures absorbed&#10;&#10;Latency story to tell: &quot;we made the SLOW path rare (5%) and the&#10;common path deterministic — that&#39;s the cheapest latency&#10;optimization there is.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="410" width="640" height="310" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="s8" name="8 · Samvaad Interview Playbook">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s8_t" value="SAMVAAD INTERVIEW PLAYBOOK — scripts, numbers, trade-offs and stories for AI Manager / Architect interviews. Pair with Page 14 of enterprise-assistant-architecture.drawio: Samvaad = the regulated-enterprise story, assistant-pro = the full-ownership builder story." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="26" as="geometry"/></mxCell>

        <mxCell id="s8_30" value="THE 30-SECOND ARCHITECTURE SCRIPT&#10;&#10;&quot;Samvaad is PHI&#39;s WhatsApp conversational AI for policy, claims and&#10;servicing journeys. Traffic enters only through the Prudential&#10;perimeter — Twilio BSP with webhook signatures, Imperva WAF, Apigee —&#10;into a single GKE service. Inside, a Google ADK root agent routes&#10;deterministically first: about 95% of turns never touch the LLM.&#10;When a turn needs reasoning, Gemini 2.5 Flash on Vertex is invoked&#10;BY the agent, screened by Model Armor inbound and outbound, with&#10;RAG retrieval scoped to the verified policyholder. Fourteen&#10;sub-agents act through a governed, risk-classified 140-tool registry&#10;with anti-IDOR ownership checks. PII is redacted before the model&#10;and before the logs. Everything is audited with correlation, session&#10;and turn IDs, gated by 1,100+ tests in CI, and deployed multi-zone&#10;with an active-passive DR region.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="540" height="310" as="geometry"/></mxCell>

        <mxCell id="s8_qa" value="SCRIPTED ANSWERS (rehearse these five)&#10;&#10;&quot;HOW DO YOU MAKE AN LLM SAFE FOR INSURANCE CUSTOMERS?&quot;&#10;→ Seven control planes (Page 5). Then the punchline: the LLM is agent-mediated and&#10;deterministic-first — most turns never reach it; the ones that do are screened both&#10;directions, grounded-only, and scoped to the verified customer. Redact BEFORE the&#10;model, redact BEFORE the logs.&#10;&#10;&quot;WHY DETERMINISTIC-FIRST INSTEAD OF LLM-FIRST?&quot;&#10;→ Cost, latency, auditability — and safety: a turn that never reaches the model cannot&#10;hallucinate or be injected. The LLM is a screened specialist, not the front door.&#10;&#10;&quot;HOW IS RAG AN AUTHORIZATION BOUNDARY?&quot;&#10;→ Retrieval is scoped to the verified policyholder and approved sources. A customer&#10;structurally CANNOT retrieve another customer&#39;s documents — access control enforced&#10;at retrieval time, not just generation time.&#10;&#10;&quot;HOW DO YOU EVALUATE A CONVERSATIONAL AI?&quot;&#10;→ Three layers: 1,100+ deterministic tests incl. security suites as PR gates; EvaCon&#10;real-pipeline conversation tests; runtime Model Armor verdict logs as continuous&#10;safety telemetry. Controls are executable, not documentation.&#10;&#10;&quot;WHAT HAPPENS IF THE REGION FAILS?&quot;&#10;→ Active-passive DR: promote the cross-region SQL read replica and Redis replica,&#10;scale the standby GKE, redirect traffic. In-region: multi-zone GKE + synchronous&#10;SQL standby + Redis auto-failover, all validated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="640" height="420" as="geometry"/></mxCell>

        <mxCell id="s8_num" value="NUMBERS TO MEMORIZE&#10;&#10;14 sub-agents · ~140 tools (risk-classified)&#10;~95% turns deterministic (no LLM call)&#10;&lt; 5s webhook ACK (async processing)&#10;min-instances 2 (warm)&#10;24h Redis session TTL · 8 MB media cap&#10;60-min GCS signed URLs&#10;1,100+ tests / 239 files (CI-gated)&#10;Ports: 443 (TLS) · 6378 (rediss) · 5432 (SQL)&#10;Gemini 2.5 Flash · asia-south1 (Mumbai)&#10;DR: asia-south2 (Delhi), active-passive&#10;Model Armor template: samvaad-adk-armor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="60" width="430" height="310" as="geometry"/></mxCell>

        <mxCell id="s8_trade" value="TRADE-OFF FLASHCARDS (both sides + verdict)&#10;&#10;ADK vs LANGGRAPH — ADK: Vertex-native, managed, org-endorsed; LangGraph: maximal&#10;control-flow control, model-agnostic. Verdict: in a GCP-standardised regulated org, ADK;&#10;the supervisor→specialists→governed-tools PATTERN is identical either way.&#10;&#10;DETERMINISTIC-FIRST vs LLM-FIRST — LLM-first feels smarter but pays cost/latency/risk&#10;on every turn. Verdict: deterministic-first with LLM escalation; measure the split (~95/5).&#10;&#10;ENTERPRISE MODEL PLATFORM vs SELF-HOSTED OSS — Vertex: residency, no-training&#10;contract, Model Armor, compliance cleared; OSS local: control + zero marginal cost but&#10;you own safety+ops. Verdict: regulated customer data → managed platform; personal/&#10;private workloads → local (assistant-pro proves I can run both).&#10;&#10;SESSION-ONLY vs LONG-TERM MEMORY — long-term memory personalises but accumulates&#10;PII risk. Verdict: in insurance, session-only + redacted durable logs; personalisation&#10;belongs in governed backend profile data, not chat memory.&#10;&#10;SINGLE SERVICE vs MICROSERVICES — one consolidated GKE service: simpler ops, one&#10;security boundary, fits one-team ownership. Split later along scaling seams if needed.&#10;&#10;TYPED TOOLS vs NL2SQL — generated SQL widens attack surface on regulated data;&#10;typed permission-checked tools are the enterprise answer (I built guarded NL2SQL in my&#10;personal platform — I know exactly what it takes to do safely)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="700" height="400" as="geometry"/></mxCell>

        <mxCell id="s8_star" value="STAR STORY SEEDS (regulated-AI leadership)&#10;&#10;SHIPPING AI THROUGH COMPLIANCE GATES — S: conversational AI touching&#10;PII/PHI in insurance. T: pass GISP security controls + DAR. A: security-by-design&#10;from day one — Model Armor templates provisioned via IaC, redaction before&#10;model/logs, 1,100+ tests incl. security suites as PR gates, evidence register.&#10;R: cleared architecture review; controls are executable, audits are fast.&#10;&#10;THE KILL-SWITCH DECISION — S: what if a journey misbehaves in prod?&#10;A: per-journey feature flags + kill switches with Redis counters, drilled in&#10;runbooks. R: any capability can be turned off in seconds without a deploy —&#10;the control that makes leadership comfortable shipping AI.&#10;&#10;WEBHOOK SLA REDESIGN — S: Twilio requires ~5s ACK; agent turns can take&#10;longer. A: decoupled ACK from processing — 200 immediately, async turn,&#10;warm min-instances. R: zero webhook timeouts, latency SLo met.&#10;&#10;DETERMINISTIC-FIRST ADVOCACY — S: pressure to &quot;just use the LLM for&#10;everything&quot;. A: showed cost/latency/risk per turn; built deterministic router&#10;with LLM escalation. R: ~95% of turns model-free — cost and risk collapsed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="500" width="620" height="360" as="geometry"/></mxCell>

        <mxCell id="s8_two" value="TWO PROJECTS, ONE STORY&#10;&#10;SAMVAAD — &quot;I operate AI in a regulated&#10;enterprise&quot;: GCP, ADK, Model Armor,&#10;compliance gates, DR, 1,100+ tests.&#10;&#10;ASSISTANT-PRO — &quot;I can build the whole&#10;stack myself&quot;: LangGraph supervisor, RAG,&#10;guarded NL2SQL, multi-LLM gateway,&#10;feedback loop — end to end.&#10;&#10;Together: pattern-level mastery&#10;(supervisor → specialists → governed&#10;tools → screened models → eval loop)&#10;proven in BOTH a regulated org and a&#10;from-scratch build. That combination is&#10;the senior-hire signal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="400" width="290" height="330" as="geometry"/></mxCell>

        <mxCell id="s8_red" value="RED FLAGS TO AVOID (regulated-AI edition)&#10;&#10;✗ &quot;We send the chat to the LLM and return the answer&quot; — no mediation story&#10;✗ Ignoring data residency / no-training contracts when naming a model&#10;✗ RAG described only as relevance — never as an access-control surface&#10;✗ No kill-switch / rollback answer for a misbehaving AI capability&#10;✗ &quot;We log everything&quot; — without redaction, that IS the data breach&#10;✗ Quoting OWASP LLM Top-10 but unable to map one item to a concrete control&#10;✗ No human-escalation path in a customer-facing regulated journey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="700" height="190" as="geometry"/></mxCell>
        <mxCell id="s8_wb" value="WHITEBOARD TIPS (Samvaad edition)&#10;&#10;• Draw the perimeter FIRST (WhatsApp → Imperva → Apigee → GKE) — in regulated&#10;   interviews, ingress control is the opening move&#10;• Then the ADK spine: root → deterministic router → sub-agents → tool registry&#10;• Put Model Armor ON BOTH SIDES of the model box — visually shows in/out screening&#10;• Annotate ~95% on the deterministic path — the single most memorable number&#10;• Close with the eval + DR story — tests as gates, active-passive failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="880" width="620" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
