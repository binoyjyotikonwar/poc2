<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="s1" name="1 · Solution Overview &amp; Tech Stack">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s1_t" value="SAMVAAD (&quot;संवाद&quot; — conversation) — WhatsApp Conversational AI Assistant for Prudential Health India (PHI). Agentic AI on Google ADK, deployed on PHI GCP behind the Prudential perimeter. NOT a free-form LLM chat: the model is a bounded, agent-mediated component." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="26" as="geometry"/></mxCell>

        <mxCell id="s1_what" value="WHAT IT IS&#10;&#10;Customer self-service conversational AI over WhatsApp delivering&#10;policy, claims, servicing, knowledge and support journeys to PHI&#10;customers.&#10;&#10;• Multi-agent orchestration on Google ADK (Agent Development&#10;   Kit): ROOT agent → 14 specialised sub-agents → governed,&#10;   risk-classified registry of ~140 tools&#10;• Gemini 2.5 Flash (Vertex AI) invoked BY the agent runtime as a&#10;   bounded reasoning / extraction / language component&#10;• ~95% of customer turns resolved DETERMINISTICALLY —&#10;   no model invocation at all&#10;• Every model call is mediated: Model Armor screening, tool&#10;   authorisation, audit&#10;• Single consolidated GKE service (FastAPI · Python 3.14 Alpine ·&#10;   autoscaling · VPC-native)&#10;• Not internet-published: ingress ONLY via WhatsApp Business&#10;   (Twilio BSP) → Imperva WAF/DDoS → Apigee → GKE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="440" height="360" as="geometry"/></mxCell>

        <mxCell id="s1_stack" value="TECHNOLOGY STACK (all TAC/TDWG-endorsed)&#10;&#10;Compute…………………Google GKE — Samvaad single service (PaaS container, managed)&#10;App runtime……………Python 3.14 (Alpine) · FastAPI · Uvicorn&#10;Agent runtime…………Google ADK — root agent + 14 sub-agents + ~140-tool registry (in-process)&#10;LLM………………………Vertex AI Gemini 2.5 Flash (PruGenAI/PHI version, asia-south1) — agent-invoked only&#10;AI safety………………Vertex AI Model Armor v1 (inbound + outbound screening)&#10;Vision…………………Cloud Vision v1 (image safety / OCR — Gemini extraction)&#10;RAG………………………Vertex AI Search (Discovery Engine v1) — knowledge grounding&#10;Embeddings……………Vertex AI text-embedding-005&#10;DB…………………………Cloud SQL for PostgreSQL (managed · private IP · Cloud SQL Connector · TLS 5432)&#10;Cache/session…………Memorystore for Redis (managed · rediss/TLS 6378 · 24h session TTL)&#10;Objects…………………Google Cloud Storage (v4 signed URLs, 60 min)&#10;API gateway……………Apigee (OAuth · rate limiting · threat protection · request validation)&#10;Perimeter………………Imperva WAF / DDoS (SaaS, outside the cloud org)&#10;Channel…………………Twilio — WhatsApp for Business BSP (webhook + signature)&#10;Secrets…………………GCP Secret Manager (+ HashiCorp Vault) · Workload Identity (no keys in image)&#10;Registry…………………Artifact Registry + JFrog Artifactory&#10;CI/CD……………………GitHub + GitHub Actions · Terraform/ISS (GCP blueprints) · Checkmarx · detect-secrets&#10;Observability……………Cloud Logging / Monitoring / Trace · OpenTelemetry · structured JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="700" height="360" as="geometry"/></mxCell>

        <mxCell id="s1_flow" value="PRODUCTION TRAFFIC FLOW (source → destination · port)&#10;&#10;WhatsApp User → WhatsApp for Business (Twilio BSP)……TLS 443&#10;WhatsApp for Business → Imperva (WAF/DDoS)……………TCP 443&#10;Imperva → Apigee API Gateway…………………………………TCP 443&#10;Apigee → GKE Samvaad service (restricted ingress)………TCP 443&#10;GKE → Vertex AI / Gemini · Model Armor · Vision ·&#10;         Vertex AI Search…………………443 (TLS, private Google access)&#10;GKE → PHI backends (*.pru.intranet.asia) via VPC connector…443&#10;GKE → Memorystore Redis (private IP)………6378 (rediss/TLS)&#10;GKE → Cloud SQL Postgres (private IP, Connector)……5432 (TLS)&#10;GKE → Cloud Storage / Logging / Monitoring / Trace………443&#10;&#10;Same topology in non-prod (vpc-connector-nprd-az1)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="60" width="470" height="360" as="geometry"/></mxCell>

        <mxCell id="s1_prin" value="KEY DESIGN PRINCIPLES (interview gold)&#10;&#10;1. DETERMINISTIC-FIRST — ~95% of turns resolved with NO LLM call: deterministic-flret routing, menu/list&#10;    interactions, direct tool execution. LLM only for bounded reasoning/extraction. → cost, latency, safety, auditability&#10;2. AGENT-MEDIATED MODEL ACCESS — the LLM never talks to the user or backends directly; ADK runtime&#10;    mediates every invocation under Model Armor screening + tool authorisation + audit&#10;3. SECURITY-BY-DESIGN, DEFENCE-IN-DEPTH — 7 control planes (see Page 5): channel authenticity, perimeter,&#10;    application, identity &amp; transaction, AI safety, data protection, operational&#10;4. NOT INTERNET-FACING — workload reachable only via Prudential perimeter (Imperva → Apigee); private VPC,&#10;    Workload Identity, private IPs everywhere&#10;5. WEBHOOK SLA — Twilio webhook ACK &lt; 5s: return HTTP 200 immediately, process the agent turn&#10;    asynchronously; min-instances 2 keeps containers warm&#10;6. LOW BANDWIDTH — WhatsApp text + interactive lists; media uploads capped at 8 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1160" height="230" as="geometry"/></mxCell>

        <mxCell id="s1_idx" value="PAGE INDEX&#10;&#10;1  Solution Overview &amp; Tech Stack (this page)&#10;2  GCP Hosting &amp; HA/DR — Active-Passive (Mumbai · Delhi DR)&#10;3  Zonal Data Flow — Zones 1-4 (perimeter → app pipeline →&#10;    model platform → PHI backends → data layer)&#10;4  End-to-End Journey DFD (8 journeys → backends → partners)&#10;5  Security &amp; AI-Safety Controls (defence-in-depth + CI/CD gates)&#10;6  AI Deep-Dive — ADK Orchestration, Routing &amp; Memory&#10;    (root + 14 sub-agents · ~140 tools · deterministic-first ~95%)&#10;7  AI Deep-Dive — RAG, Model Platform &amp; Evaluation&#10;    (grounding as authz boundary · why Gemini 2.5 Flash · EvaCon)&#10;8  Samvaad Interview Playbook (scripts · numbers ·&#10;    trade-offs · STAR stories · two-projects-one-story)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1220" y="450" width="470" height="230" as="geometry"/></mxCell>

        <mxCell id="s1_test" value="QUALITY EVIDENCE (from the LLD)&#10;&#10;• 1,100+ pytest tests across 239 files — CI-gated on every PR/merge; security suites include guardrails, content-safety, kill-switch, rate-limiter, anti-IDOR ownership, log-redaction&#10;• EvaCon conversation tests — wire-visible, real-pipeline end-to-end scenarios&#10;• Checkmarx SAST/SCA/CSEC + DAST + detect-secrets — Critical/High remediated before release (DAR gate)&#10;• HA validated: GKE multi-zone autoscaling &amp; instance recovery · Memorystore failover · Cloud SQL failover&#10;• Model Armor template provisioning automated (deploy-model-armor-template → samvaad-adk-armor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1160" height="150" as="geometry"/></mxCell>
        <mxCell id="s1_sup" value="SUPPORT MODEL&#10;&#10;L1 — GICC (incident handling)&#10;L2 — solution SMEs / application team&#10;L3 — engineering (in-house; no vendor SLA&#10;— built internally)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="700" width="470" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="s2" name="2 · GCP Hosting &amp; HA-DR (Active-Passive)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s2_t" value="SAMVAAD — GCP HOSTING &amp; HA/DR (ACTIVE-PASSIVE).  asia-south1 Mumbai = PRIMARY/ACTIVE (in-region multi-zone HA) · asia-south2 Delhi = DR/PASSIVE standby (scaled up on DR invocation). Solid = in-region synchronous HA · bold dashed = cross-region async DR replication · dotted = failover path." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1660" height="40" as="geometry"/></mxCell>

        <mxCell id="s2_wa" value="WhatsApp for Business / BSP (Twilio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#25D366;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="44" as="geometry"/></mxCell>
        <mxCell id="s2_perim" value="PHI Perimeter — Imperva WAF / DDoS + Apigee API Gateway&#10;OAuth · rate limit · threat protection — Samvaad is behind Prudential Firewall, NOT exposed to the internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="340" y="66" width="480" height="52" as="geometry"/></mxCell>
        <mxCell id="s2_cicd" value="CI/CD plane — GitHub (pru-phi/phi-7wd-samvaad-adk) + GitHub Actions · ISS / Terraform (GCP blueprints) · Checkmarx SAST/SCA · detect-secrets → IaC provisioning (PR-based) · deploy image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1140" y="66" width="550" height="52" as="geometry"/></mxCell>

        <mxCell id="s2_org" value="PHI GCP Organization / Project — pruinhlth-nprd — VPC (Shared, private) · Workload Identity" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f2f7fd;strokeColor=#4285F4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#1a73e8;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1650" height="1090" as="geometry"/></mxCell>
        <mxCell id="s2_glb" value="Global External HTTPS Load Balancer + Cloud Armor (WAAP) — container-native NEG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="480" y="180" width="560" height="44" as="geometry"/></mxCell>

        <mxCell id="s2_r1" value="Region: asia-south1 (Mumbai) — PRIMARY / ACTIVE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#1a73e8;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="760" height="560" as="geometry"/></mxCell>
        <mxCell id="s2_gke1" value="GKE — Samvaad service (FastAPI · autoscaling · VPC-native)&#10;Zone a · Zone b · Zone c — managed multi-zone = HA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="700" height="70" as="geometry"/></mxCell>
        <mxCell id="s2_sql1" value="Cloud SQL for PostgreSQL — Primary (Regional HA)&#10;CMEK · Private IP · PITR · pgAudit · conversation_logs (redacted)&#10;Primary instance (Zone a) — synchronous replication / automatic failover (in-region HA) → Synchronous standby (Zone b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="700" height="90" as="geometry"/></mxCell>
        <mxCell id="s2_redis1" value="Memorystore (Redis) — Standard HA&#10;ADK session · 24h TTL · rediss:// TLS+AUTH&#10;Primary (Zone a) — automatic failover (in-region HA) → Replica (Zone b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="700" height="84" as="geometry"/></mxCell>
        <mxCell id="s2_ha1" value="IN-REGION HA SUMMARY (validated by PHI Cloud Engineering)&#10;• GKE: multi-zone node pools, autoscaling, automatic instance recovery&#10;• Cloud SQL: synchronous standby in second zone, automatic failover, RPO≈0&#10;• Redis: automatic replica promotion&#10;• LB health checks steer around unhealthy zones — no DNS change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="100" y="640" width="700" height="140" as="geometry"/></mxCell>

        <mxCell id="s2_r2" value="Region: asia-south2 (Delhi) — DISASTER RECOVERY / PASSIVE (Standby)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#5f6368;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="260" width="780" height="560" as="geometry"/></mxCell>
        <mxCell id="s2_lb2" value="Internal / Global LB target (standby)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="910" y="300" width="720" height="36" as="geometry"/></mxCell>
        <mxCell id="s2_gke2" value="GKE — Samvaad service (DR — passive standby · minimal footprint · scaled up on failover)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=11;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="910" y="352" width="720" height="44" as="geometry"/></mxCell>
        <mxCell id="s2_sql2" value="Cloud SQL for PostgreSQL — Cross-Region Read Replica (DR)&#10;read replica — PROMOTED to primary on DR invocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=11;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="910" y="420" width="720" height="60" as="geometry"/></mxCell>
        <mxCell id="s2_redis2" value="Memorystore (Redis) — Cross-Region Replica (DR, standby)&#10;promoted on failover (sessions reconstructable — 24h TTL, not system-of-record)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=11;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="910" y="500" width="720" height="60" as="geometry"/></mxCell>
        <mxCell id="s2_dr2" value="DR INVOCATION SEQUENCE (active-passive)&#10;① Declare DR → ② promote Cloud SQL read replica to primary → ③ promote Redis replica →&#10;④ scale up DR GKE (minimal footprint → full) → ⑤ repoint LB / traffic redirect to asia-south2 →&#10;⑥ Vertex AI &amp; shared services already regional/shared — used by whichever region is active&#10;Backups: Cloud SQL automated daily + PITR (retention per Group BCM/ITDR) · Redis RDB snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="910" y="640" width="720" height="140" as="geometry"/></mxCell>

        <mxCell id="s2_shared" value="Shared services — one setup, common to both regions (project-wide, pruinhlth-nprd)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;dashed=1;dashPattern=2 2;" vertex="1" parent="1"><mxGeometry x="70" y="850" width="1590" height="240" as="geometry"/></mxCell>
        <mxCell id="s2_vertex" value="Vertex AI (regional, managed) — asia-south1&#10;• Gemini 2.5 Flash (PruGenAI — PHI version)&#10;• Vertex AI Search (RAG / Discovery Engine)&#10;• Vision / OCR · text-embedding-005&#10;regional in asia-south1 — used by the active region and by DR on failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="100" y="890" width="440" height="120" as="geometry"/></mxCell>
        <mxCell id="s2_gcs" value="Cloud Storage (GCS)&#10;document store&#10;v4 signed URLs (60 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="890" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="s2_kms" value="Cloud KMS (CMEK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="890" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="s2_sm" value="Secret Manager /&#10;HashiCorp Vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="890" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="s2_ar" value="Artifact Registry&#10;(container image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="970" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="s2_obs" value="Cloud Logging / Cloud Monitoring / Cloud Trace / Managed Prometheus — single observability setup for both regions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="970" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="s2_note" value="Per-region: GKE, Cloud SQL, Memorystore.&#10;Shared/global: Vertex AI, GCS, KMS, Secret&#10;Manager, Artifact Registry, Observability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1180" y="890" width="450" height="140" as="geometry"/></mxCell>

        <mxCell id="s2_e1" value="HTTPS 443" style="endArrow=block;html=1;strokeColor=#25D366;fontSize=10;" edge="1" parent="1" source="s2_wa" target="s2_perim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2_e2" value="reaches GKE via Global HTTPS LB" style="endArrow=block;html=1;strokeColor=#c5221f;fontSize=10;" edge="1" parent="1" source="s2_perim" target="s2_glb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2_e3" value="deploy image (Workload Identity)" style="endArrow=block;html=1;dashed=1;strokeColor=#5f6368;fontSize=10;" edge="1" parent="1" source="s2_cicd" target="s2_glb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2_e4" value="ACTIVE" style="endArrow=block;html=1;strokeColor=#1a73e8;strokeWidth=3;fontColor=#1a73e8;fontSize=10;" edge="1" parent="1" source="s2_glb" target="s2_gke1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2_e5" value="DR failover (traffic redirect) · active-passive" style="endArrow=block;html=1;dashed=1;dashPattern=2 4;strokeColor=#c62828;strokeWidth=2;fontColor=#c62828;fontSize=10;" edge="1" parent="1" source="s2_glb" target="s2_lb2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2_e6" value="cross-region async DR replication" style="endArrow=block;html=1;dashed=1;strokeColor=#202124;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="s2_sql1" target="s2_sql2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2_e7" value="cross-region async replication" style="endArrow=block;html=1;dashed=1;strokeColor=#202124;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="s2_redis1" target="s2_redis2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2_e8" style="endArrow=block;html=1;strokeColor=#9e9e9e;dashed=1;" edge="1" parent="1" source="s2_lb2" target="s2_gke2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2_e9" style="endArrow=block;html=1;strokeColor=#4285F4;" edge="1" parent="1" source="s2_gke1" target="s2_vertex"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="s3" name="3 · Zonal Data Flow (Zones 1-4)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s3_t" value="SAMVAAD — ZONAL DATA FLOW (PHI GCP). Not directly exposed to the internet — inbound ONLY via the Prudential perimeter. AI-safety screening BEFORE any LLM call. Secrets via Secret Manager · Workload Identity (no keys in image)." style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1700" height="26" as="geometry"/></mxCell>

        <mxCell id="s3_z1" value="ZONE 1 — External / Customer-facing (Internet)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#c5221f;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontStyle=1;fontColor=#c5221f;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="250" height="700" as="geometry"/></mxCell>
        <mxCell id="s3_user" value="WhatsApp User&#10;(Customer / Policyholder)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5221f;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="110" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="s3_wab" value="WhatsApp for Business" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#25D366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="220" width="200" height="44" as="geometry"/></mxCell>
        <mxCell id="s3_bsp" value="BSP — Twilio&#10;(webhook + signature)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5221f;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="330" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="s3_z1n" value="Samvaad is NOT directly reachable from the internet. Inbound enters only via the Prudential perimeter (Imperva → Apigee)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="65" y="420" width="200" height="90" as="geometry"/></mxCell>

