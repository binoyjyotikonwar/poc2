        <mxCell id="dt" value="Per-system Solution Detail — the 5-step template applied, system by system  (① stable endpoint · ② warm az2 + active-passive Pub/Sub · ③ kill -az1- config · ④ repoint Apigee · ⑤ az2 secrets/plumbing)" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1520" height="40" as="geometry"/></mxCell>

        <!-- Row 1 -->
        <mxCell id="c_il" value="INTEGRATION LAYER — chbb3e (HUB, do first)&#10;① Stable: *.lb1-pruinhlth-prd-chbb3e.pru.intranet.asia&#10;② az1 active + az2 warm (min=1); Pub/Sub active-passive&#10;③ rewrite domainSuffix, filenet.baseUrl, pas.api.baseUrl&#10;④ repoint all 17 Apigee targets ⑤ fix Bug#1 (dr→UAT) + Bug#2 (mTLS cert)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c_pas" value="PAS / TCS BaNCS — vpkcai&#10;① Stable: pas-services-prod.lb1-...-chbb3e; core-prod.lb1-...-vpkcai&#10;② az1 active + az2 warm; sync HTTP (no Pub/Sub)&#10;③ rewrite bancsHost, domainSuffix → stable&#10;NOTE: cross-region DR RTO 1h applies only to full-region loss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c_fn" value="FileNet / BAW / ODM — nhq8h1&#10;① Stable: cp4ba/filenet-...-nhq8h1.pru.intranet.asia&#10;② az1 active + az2 warm&#10;③ rewrite filenet/cp4ba host → stable&#10;⚠ DB2-on-VM + on-prem AD (DSG001/002) = own HA/DR (out of GKE scope)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="480" height="150" as="geometry"/></mxCell>

        <!-- Row 2 -->
        <mxCell id="c_crm" value="SimpleCRM — rzg0c4&#10;① Stable: crm-prod.lb1-pruinhlth-prd-rzg0c4.pru.intranet.asia&#10;② az1 active + az2; Pub/Sub consumer → active-passive&#10;③ rewrite crm.simple.baseUrl (was -az1-rzg0c4)&#10;④ repoint Apigee CRM target → stable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c_samv" value="Samvaad — f950ic&#10;① Stable: samvaad-service-prod.lb1-...-f950ic&#10;② az1 active + az2 warm; inbound via Apigee&#10;⑤ ADD az2 VPC connector (only az1 today)&#10;③ egress targets (Hasura/CRM/PAS/FileNet) → stable names" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c_chub" value="CHUB / Comms&#10;① Stable REST endpoint over az1+az2&#10;② az1 active + az2; Pub/Sub consumer → active-passive&#10;③ rewrite REST host → stable&#10;NOTE: also fed by Pub/Sub (self-healing)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="240" width="480" height="150" as="geometry"/></mxCell>

        <!-- Row 3 -->
        <mxCell id="c_pixel" value="PIXEL / Doc Digitisation — dp1d50&#10;① Stable: digitisation-...-dp1d50.pru.intranet.asia&#10;② az1 active + az2; ⑤ confirm az2 VPC connector&#10;③ rewrite ingress host → stable&#10;NOTE: correct az2=zone label (not 'Delhi')" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c_health" value="Health App — rzg0c4  (was DIRECT -az1- caller ①)&#10;① Stable: healthapp-...-rzg0c4.pru.intranet.asia&#10;② az1 active + az2 warm&#10;③ own ingress + comms-svc + party-management → stable names&#10;RESULT: no more az1 link; Apigee + stable direct" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="410" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c_fyn" value="FYNTUNE (distributed) — own project  (was DIRECT -az1-, bypassed Apigee ①)&#10;① Stable: its own L4 NLB failover VIP over az1+az2&#10;② az1 active + az2 warm&#10;③ point at IL's STABLE name (or az1-failover-DNS = no change); fix own -az1- deps&#10;④⑤ repoint any callers + az2 secrets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="410" width="480" height="150" as="geometry"/></mxCell>

